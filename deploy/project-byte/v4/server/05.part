 models set success_count=success_count+1 where model_key=?",(run["model_key"],))
        else:
            c.execute("update agents set failure_count=failure_count+1 where agent_key=?",(run["agent_key"],));c.execute("update models set failure_count=failure_count+1 where model_key=?",(run["model_key"],))
        c.execute("update runs set learned=1 where id=?",(run["id"],))


def bridge_status(repo: str, issue: int) -> tuple[str,str,str]:
    state_dir=BRIDGE_STATE.get(repo)
    if not state_dir:return "queued","",""
    state_file=state_dir/"processed.json"
    status="queued";pr="";detail=""
    try:
        if state_file.exists():
            data=json.loads(state_file.read_text());rec=(data.get("processed") or {}).get(str(issue))
            if rec:status=rec.get("status",status);pr=rec.get("pr","");detail=rec.get("error","") or rec.get("classification","")
    except Exception as e:detail=str(e)
    log_file=state_dir/"logs"/f"issue-{issue}.log"
    if log_file.exists() and status=="queued":status="running"
    return status,pr,detail


def sync_runs_once():
    for run in run_rows():
        if run["status"] in ("pr-created","opencode-failed","bridge-error","diff-check-failed","no-changes","skipped-existing-branch"):continue
        status,pr,detail=bridge_status(run["repo"],run["issue_number"])
        if status!=run["status"] or pr!=run["pr_url"]:
            with con() as c:
                c.execute("update runs set status=?,pr_url=?,last_event=?,updated_at=?,finished_at=? where id=?",(status,pr,txt(detail or status,800),now(),now() if status in ("pr-created","opencode-failed","bridge-error","diff-check-failed","no-changes","skipped-existing-branch") else 0,run["id"]))
                c.execute("update tasks set ai_state=?,github_pr_url=?,updated_at=? where id=?",(status,pr,now(),run["task_id"]))
                audit(c,"ai_run_status",run["task_id"],run["project"],status,"system")
            add_run_event(run["id"],"status",status,run["agent_key"],detail)
            fresh=dict(run);fresh["status"]=status;fresh["pr_url"]=pr;learn_from_run(fresh,status,detail)


def sync_loop():
    while True:
        try:sync_runs_once()
        except Exception:pass
        time.sleep(10)


def tail_run(run_id: str) -> dict:
    run=next((r for r in run_rows() if r["id"]==run_id),None)
    if not run:return {"lines":[],"status":"not-found"}
    state_dir=BRIDGE_STATE.get(run["repo"]);lines=[]
    if state_dir:
        p=state_dir/"logs"/f"issue-{run['issue_number']}.log"
        if p.exists():
            try:
                text=sanitize(p.read_text(errors="replace")); lines=text.splitlines()[-180:]
            except Exception:pass
    return {"lines":lines,"status":run["status"],"issue_url":run["issue_url"],"pr_url":run["pr_url"],"events":rows("select * from run_events where run_id=? order by id desc limit 80",(run_id,))}


def score_task(t, ph, by_id):
    if t["status"]=="Done":return -999
    score={"Critical":50,"High":35,"Medium":20,"Low":10}.get(t["priority"],0)+{"Blocked":20,"Active":15,"Review":10,"Backlog":5}.get(t["status"],0)+{"Blocked":20,"At risk":10,"Paused":-10}.get(ph.get(t["project"],"On track"),0)
    if t.get("due_date"):
        try:
            days=(datetime.strptime(t["due_date"],"%Y-%m-%d").date()-date.today()).days;score+=35 if days<0 else 30 if days<=2 else 20 if days<=7 else 10 if days<=14 else 0
        except ValueError:pass
    dep=t.get("depends_on"); blocked_by=bool(dep and by_id.get(dep) and by_id[dep]["status"]!="Done")
    if blocked_by:score-=35
    unlocks=sum(1 for x in by_id.values() if x.get("depends_on")==t["id"] and x["status"]!="Done")
    score+=unlocks*8;progress=max(0,min(int(t.get("progress") or 0),100));score+=6 if progress>=75 else 3 if progress>=50 else 0
    return score


def intelligence():
    ts=task_rows();ps=project_rows();ph={p["name"]:p["health"] for p in ps};by={t["id"]:t for t in ts};rank=[]
    for t in ts:
        x=dict(t);x["score"]=score_task(t,ph,by);dep=t.get("depends_on","");x["dependency_title"]=by.get(dep,{}).get("title","") if dep else "";rank.append(x)
    rank=[x for x in rank if x["score"]>-999];rank.sort(key=lambda x:(-x["score"],x.get("due_date") or "9999-12-31",x["title"]))
    today=date.today().isoformat();open_=[t for t in ts if t["status"]!="Done"]
    return {"top":rank[:10],"signals":{"blocked":sum(t["status"]=="Blocked" for t in open_),"critical_open":sum(t["priority"]=="Critical" for t in open_),"overdue":sum(bool(t.get("due_date") and t["due_date"]<today) for t in open_),"unassigned":sum(not t.get("owner") for t in open_),"ai_running":sum(r["status"] in ("queued","running") for r in run_rows())},"method":"Priority + workflow state + project health + due-date urgency - unfinished dependencies + tasks unlocked + finishability."}


class H(SimpleHTTPRequestHandler):
    server_version="PROJECT_BYTE/4.0"
    def __init__(self,*a,**kw):super().__init__(*a,directory=str(ROOT),**kw)
    def log_message(self,fmt,*args):print("%s - %s"%(self.address_string(),fmt%args))
    def sendj(self,obj,code=200):
        b=json.dumps(obj,separators=(",",":"),ensure_ascii=False).encode();self.send_response(code);self.send_header("Content-Type","application/json; charset=utf-8");self.send_header("Cache-Control","no-store");self.send_header("X-Content-Type-Options","nosniff");self.send_header("Referrer-Policy","same-origin");self.send_header("Content-Length",str(len(b)));self.end_headers();self.wfile.write(b)
    def body(self,limit=1024*1024):
        try:
            n=int(self.headers.get("Content-Length","0"));return json.loads(self.rfile.read(n)) if 0<n<=limit else None
        except Exception:return None
    def who(self):return auth(self.headers,self.client_address[0])
    def need(self,level):
        u=self.who()
        if u["level"]>=level:return u
        self.sendj({"error":"access denied","required":level},403);return None
    def do_GET(self):
        p=unquote(urlparse(self.path).path);q=parse_qs(urlparse(self.path).query);u=self.who()
        if p=="/healthz":return self.sendj({"ok":True,"version":4,"ai_ops":True})
        if p=="/api/session":return self.sendj(u)
        if p=="/api/tasks":return self.sendj({"tasks":task_rows()})
        if p=="/api/projects":return self.sendj({"projects":project_rows()})
        if p=="/api/intelligence":return self.sendj(intelligence())
        if p=="/api/activity":return self.sendj({"activity":activity_rows()})
        if p=="/api/models":return self.sendj({"models":model_rows()})
        if p=="/api/agents":return self.sendj({"agents":agent_rows()})
        if p=="/api/runs":return self.sendj({"runs":run_rows()})
        if p=="/api/team":
            if not self.need(3):return
            return self.sendj({"team":team_rows()})
        if p=="/api/memory":
            if not self.need(2):return
            return self.sendj({"memory":memory_rows(txt((q.get('agent') or [''])[0],80),txt((q.get('project') or [''])[0],80))})
        if p=="/api/chat"