def now() -> int:
    return int(time.time())


def con() -> sqlite3.Connection:
    c = sqlite3.connect(DB, timeout=15)
    c.row_factory = sqlite3.Row
    c.execute("pragma foreign_keys=on")
    c.execute("pragma journal_mode=WAL")
    return c


def digest(value: str) -> str:
    return hashlib.sha256(value.encode()).hexdigest()


def txt(value, limit: int) -> str:
    return str(value or "").strip()[:limit]


def sanitize(value: str) -> str:
    return SECRET_RE.sub("[REDACTED]", value or "")


def addcol(c: sqlite3.Connection, table: str, name: str, definition: str) -> None:
    if name not in {r["name"] for r in c.execute(f"pragma table_info({table})")}:
        c.execute(f"alter table {table} add column {name} {definition}")


def valid_date(value) -> str:
    value = txt(value, 10)
    if value:
        datetime.strptime(value, "%Y-%m-%d")
    return value


def valid_url(value) -> str:
    value = txt(value, 600)
    if value:
        u = urlparse(value)
        if u.scheme not in ("http", "https") or not u.netloc:
            raise ValueError("invalid url")
    return value


def valid_repo(value) -> str:
    value = txt(value, 160)
    if value and not REPO_RE.fullmatch(value):
        raise ValueError("invalid repo")
    return value


def valid_hint(value) -> str:
    value = txt(value, 140)
    if value and not HINT_RE.fullmatch(value):
        raise ValueError("invalid execution hint")
    return value


def owner_secret() -> str:
    if not SECRET.exists():
        fd = os.open(SECRET, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(uuid.uuid4().hex + uuid.uuid4().hex[:8])
    return SECRET.read_text().strip()


def audit(c, action: str, task: str = "", project: str = "", detail: str = "", actor: str = "system") -> None:
    c.execute(
        "insert into activity(ts,action,task_id,project,detail,actor) values(?,?,?,?,?,?)",
        (now(), action, task, project, txt(detail, 800), txt(actor, 80)),
    )


def init_db() -> None:
    UPLOADS.mkdir(exist_ok=True)
    with con() as c:
        c.execute("""create table if not exists tasks(
            id text primary key,title text not null,project text not null,status text not null,
            priority text not null,note