:
            if not self.need(2):return
            return self.sendj({"messages":chat_rows(txt((q.get('project') or [''])[0],80),txt((q.get('task') or [''])[0],80))})
        if p.startswith("/api/runs/") and p.endswith("/terminal"):
            if not self.need(2):return
            return self.sendj(tail_run(p.split("/")[3]))
        if p=="/api/help":return self.sendj({"guide":HELP_GUIDE})
        if p=="/":self.path="/index.html"
        return super().do_GET()
    def do_POST(self):
