            with con() as c:c.execute("insert into chat_messages(ts,actor,role,project,task_id,model_key,content) values(?,?,?,?,?,?,?)",(now(),u["name"],"user",project,tid,model_key,user_text))
            try:answer,latency=call_model(model_key,[{"role":"system","content":system},{"role":"user","content":user_text}])
