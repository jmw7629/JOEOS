            marker=BRIDGES[project["repo"]];body=f"{marker}\n\nPROJECT_BYTE_TASK_ID: {tid}\nPROJECT_BYTE_AGENT_HINT: {agent}\nPROJECT_BYTE_MODEL_HINT: {model}\n\n{prompt}"
