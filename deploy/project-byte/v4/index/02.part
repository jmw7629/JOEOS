:16px}.modalwrap.open{display:flex}.modal{width:min(760px,100%);max-height:92vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:16px}.modal h2{margin:0 0 12px}.label{display:flex;flex-direction:column;gap:5px;color:var(--muted);font-size:12px}.label input,.label select,.label textarea{background:#0c131b;color:var(--txt);border:1px solid var(--line);border-radius:9px;min-height:40px;padding:8px}.label textarea{min-height:90px;resize:vertical}.wide{grid-column:1/-1}.row{display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap;margin-top:12px}.fileitem{display:flex;justify-content:space-between;gap:8px;padding:5px 0}.statusline{color:var(--muted);font-size:12px;margin-top:11px}.advancedfilters{display:none;margin-top:9px;padding:10px;background:#0c131b;border:1px solid var(--line);border-radius:12px}.advancedfilters.open{display:block}.filtergrid{display:grid;grid-template-columns:repeat(6,minmax(145px,1fr));gap:8px}.filteractions{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px}.filterchip{font-size:11px;padding:5px 8px;border:1px solid #31506a;border-radius:999px;background:#10202d}.savedbar{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-top:8px}body.auth .authonly{display:inline-flex}body:not(.auth) .authonly{display:none!important}body.admin .adminonly{display:inline-flex}body:not(.admin) .adminonly{display:none!important}@media(max-width:1200px){.filtergrid{grid-template-columns:repeat(4,1fr)}}@media(max-width:980px){.metrics{grid-template-columns:repeat(4,1fr)}.grid3{grid-template-columns:1fr 1fr}.intelgrid,.ai-layout,.settingsgrid{grid-template-columns:1fr}.filtergrid{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){header,.wrap{padding-left:12px;padding-right:12px}.brand{flex-direction:column}.metrics{grid-template-columns:repeat(2,1fr)}.grid2,.grid3,.filtergrid{grid-template-columns:1fr}.wide{grid-column:auto}.event{grid-template-columns:1fr}.composer{grid-template-columns:1fr}.msg{max-width:96%}}
</style></head><body>
<header><div class="brand"><div><h1>PROJECT_BYTE</h1><p>Executive portfolio + AI operations command center</p></div><div class="top"><button id="notifyBtn" class="btn authonly">Notifications <span id="notifyBadge" class="badge"></span></button><button id="login" class="btn">Owner / Team login</button><button id="newTask" class="btn primary authonly">+ Work item</button><button id="refresh" class="btn">Refresh</button></div></div>
<nav class="tabs"><button class="tab active" data-view="portfolio">Portfolio</button><button class="tab" data-view="board">Kanban</button><button class="tab" data-view="intelligence">Work next</button><button class="tab" data-view="ai">AI</button><button class="tab" data-view="agents">Agents</button><button class="tab" data-view="terminalView">Terminal</button><button class="tab" data-view="models">Models</button><button class="tab" data-view="team">Team</button><button class="tab" data-view="activity">Activity</button><button class="tab authonly" data-view="settings">Settings</button><button class="tab" data-view="help">Help / How-To</button></nav>
<div class="filters"><input id="search" class="field" type="search" placeholder="Search projects, work, milestones, people, AI state"><select id="projectFilter" class="field"><option value="">All projects</option></select><select id="ownerFilter" class="field"><option value="">All task owners</option></select><select id="priorityFilter" class="field"><option value="">All priorities</option><option>Critical</option><option>High</option><option>Medium</option><option>Low</option></select><button id="filterToggle" class="btn">Filters <span id="filterCount" class="badge"></span></button></div>
<div id="advancedFilters" class="advancedfilters"><div class="filtergrid">
<label class="label">Project lead<select id="leadFilter"><option value="">All leads</option></select></label>
<label class="label">Status<select id="statusFilter"><option value="">All statuses</option><option>Backlog</option><option>Active</option><option>Blocked</option><option>Review</option><option>Done</option></select></label>
<label class="label">Project health<select id="healthFilter"><option value="">All health</option><option>On track</option><option>At risk</option><option>Blocked</option><option>Paused</option></select></label>
<label class="label">Project stage<select id="stageFilter"><option value="">All stages</option></select></label>
<label class="label">Executor<select id="executorFilter"><option value="">Human + AI</option><option value="human">Human</option><option value="ai">AI</option></select></label>
<label class="label">Agent<select id="agentFilter"><option value="">All agents</option></select></label>
<label class="label">Model<select id="modelFilter"><option value="">All models</option></select></label>
<label class="label">AI state<select id="aiStateFilter"><option value="">All AI states</option><option>queued</option><option>running</option><option>pr-created</option><option>opencode-failed</option><option>bridge-error</option><option>diff-check-failed</option><option>no-changes</option></select></label>
<label class="label">Due window<select id="dueFilter"><option value="">Any due date</option><option value="overdue">Overdue</option><option value="today">Due today</option><option value="2d">Due ≤2 days</option><option value="7d">Due ≤7 days</option><option value="30d">Due ≤30 days</option><option value="none">No due date</option></select></label>
<label class="label">Completion<select id="completionFilter"><option value="">All work</option><option value="open">Open only</option><option value="done">Done only</option></select></label>
<label class="label">Dependency<select id="dependencyFilter"><option value="">Any dependency</option><option value="blocked">Blocked by unfinished dependency</option><option value="unlocks">Unlocks other work</option><option value="has">Has dependency</option><option value="none">No dependency</option></select></label>
<label class="label">Activity<select id="activityFilter"><option value="">Any update age</option><option value="24h">Updated ≤24h</option><option value="7d">Updated ≤7 days</option><option value="stale">Stale &gt;7 days</option></select></label>
<label class="label">Milestone<select id="milestoneFilter"><option value="">All milestones</option></select></label>
<label class="label">Repository<select id="repoFilter"><option value="">All repositories</option></select></label>
<label class="label">AI run<select id="runFilter"><option value="">Any run state</option><option value="active">Active AI run</option><option value="none">No AI run</option><option value="finished">Finished AI run</option></select></label>
<label class="label">Project scope<select id="scopeFilter"><option value="">All ownership</option><option value="mine">My projects / work</option><option value="unassigned">Unassigned work</option></select></label>
</div><div class="savedbar authonly"><select id="savedView" class="field"><option value="">Saved views</option></select><button id="saveView" class="mini">Save current view</button><button id="deleteView" class="mini danger">Delete saved view</button><button id="clearFilters" class="mini">Clear filters</button><span id="activeFilterSummary" class="small"></span></div></div></header>
<main class="wrap"><section class="metrics"><div class="metric"><span>Open</span><b id="mOpen">0</b></div><div class="metric"><span>Active</span><b id="mActive">0</b></div><div class="metric"><span>Blocked</span><b id="mBlocked">0</b></div><div class="metric"><span>Critical</span><b id="mCritical">0</b></div><div class="metric"><span>Overdue</span><b id="mOverdue">0</b></div><div class="metric"><span>AI running</span><b id="mAI">0</b></div><div class="metric"><span>Done</span><b id="mDone">0%</b></div></section>
<section id="portfolio" class="view active"><div id="projects" class="projects"></div></section>
<section id="board" class="view"><div class="boardscroll"><div id="boardGrid" class="board"></div></div></section>
<section id="intelligence" class="view"><div class="intelgrid"><div class="panel"><h2>Priority engine · work next</h2><div id="ranking"></div><div id="method" class="small"></div></div><aside class="panel"><h2>Executive signals</h2><div class="signals"><div class="signal"><b id="sBlocked">0</b><span>Blocked</span></div><div class="signal"><b id="sCritical">0</b><span>Critical</span></div><div class="signal"><b id="sOverdue">0</b><span>Overdue</span></div><div class="signal"><b id="sUnassigned">0</b><span>Unassigned</span></div></div></aside></div></section>
<section id="ai" class="view"><div class="ai-layout"><div class="panel chatbox"><div class="between"><div><h2>PROJECT_BYTE AI</h2><div class="small">Talk through a project, draft an execution prompt, troubleshoot, or queue approved work.</div></div><button id="loadChat" class="mini authonly">Reload context</button></div><div id="chatlog" class="chatlog"></div><div class="grid3" style="margin-top:9px"><label class="label">Project<select id="aiProject"></select></label><label class="label">Task<select id="aiTask"><option value="">No task selected</option></select></label><label class="label">Agent<select id="aiAgent"></select></label><label class="label">Model<select id="aiModel"></select></label><div class="wide flex"><button id="draftPrompt" class="btn authonly">Draft execution prompt</button><button id="queueSelected" class="btn primary authonly">Queue selected task to AI</button><button id="askHelp" class="btn authonly">Ask Help Agent</button></div></div><div class="composer"><textarea id="chatInput" class="field" placeholder="Ask about the selected project/task…"></textarea><button id="sendChat" class="btn primary authonly">Send</button></div></div><aside class="panel"><h2>Selected context</h2><div id="contextSummary" class="small">Choose a project/task.</div><hr style="border-color:var(--line);border-width:1px 0 0;margin:12px 0"><h2>Queue discipline</h2><div class="small">Chat never launches code by itself. Queue to AI creates the approved GitHub [OC] issue, then your VPS bridge executes it in an isolated worktree and creates a PR. No auto-merge.</div></aside></div></section>
<section id="agents" class="view"><div class="between" style="margin-bottom:10px"><div><h2 style="margin:0">Agents & learning</h2><div class="small">Roles are separate from models. Execution outcomes become auditable memory and performance data.</div></div><button id="addMemory" class="btn authonly">+ Memory</button></div><div id="agentGrid" class="agentgrid"></div><div class="grid2" style="margin-top:12px"><div class="panel"><h2>Live / recent runs</h2><div id="runList" class="runlist"></div></div><div class="panel"><h2>Memory & learning</h2><div id="memoryList"></div></div></div></section>
<section id="terminalView" class="view"><div class="panel"><div class="terminaltop"><select id="terminalRun" class="field"><option value="">Select an agent run</option></select><button id="terminalRefresh" class="btn authonly">Refresh terminal</button><a id="terminalIssue" class="btn" target="_blank" rel="noopener" style="display:none">Issue</a><a id="terminalPR" class="btn" target="_blank" rel="noopener" style="display:none">PR</a></div><div class="small" style="margin-bottom:8px">Read-only execution view. This shows the bridge/OpenCode log and run events; it is intentionally not an unrestricted server shell.</div><pre id="terminal" class="terminal">Select a run to inspect execution.</pre></div></section>
<section id="models" class="view"><div class="between" st