:16px}.modalwrap.open{display:flex}.modal{width:min(760px,100%);max-height:92vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:16px}.modal h2{margin:0 0 12px}.label{display:flex;flex-direction:column;gap:5px;color:var(--muted);font-size:12px}.label input,.label select,.label textarea{background:#0c131b;color:var(--txt);border:1px solid var(--line);border-radius:9px;min-height:40px;padding:8px}.label textarea{min-height:90px;resize:vertical}.wide{grid-column:1/-1}.row{display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap;margin-top:12px}.fileitem{display:flex;justify-content:space-between;gap:8px;padding:5px 0}.statusline{color:var(--muted);font-size:12px;margin-top:11px}body.auth .authonly{display:inline-flex}body:not(.auth) .authonly{display:none!important}body.admin .adminonly{display:inline-flex}body:not(.admin) .adminonly{display:none!important}@media(max-width:980px){.metrics{grid-template-columns:repeat(4,1fr)}.grid3{grid-template-columns:1fr 1fr}.intelgrid,.ai-layout{grid-template-columns:1fr}}@media(max-width:650px){header,.wrap{padding-left:12px;padding-right:12px}.brand{flex-direction:column}.metrics{grid-template-columns:repeat(2,1fr)}.grid2,.grid3{grid-template-columns:1fr}.wide{grid-column:auto}.event{grid-template-columns:1fr}.composer{grid-template-columns:1fr}.msg{max-width:96%}}
</style></head><body>
<header><div class="brand"><div><h1>PROJECT_BYTE</h1><p>Executive portfolio + AI operations command center</p></div><div class="top"><button id="login" class="btn">Owner / Team login</button><button id="newTask" class="btn primary authonly">+ Work item</button><button id="refresh" class="btn">Refresh</button></div></div>
<nav class="tabs"><button class="tab active" data-view="portfolio">Portfolio</button><button class="tab" data-view="board">Kanban</button><button class="tab" data-view="intelligence">Work next</button><button class="tab" data-view="ai">AI</button><button class="tab" data-view="agents">Agents</button><button class="tab" data-view="terminalView">Terminal</button><button class="tab" data-view="models">Models</button><button class="tab" data-view="team">Team</button><button class="tab" data-view="activity">Activity</button><button class="tab" data-view="help">Help / How-To</button></nav>
<div class="filters"><input id="search" class="field" type="search" placeholder="Search projects, work, milestones, people, AI state"><select id="projectFilter" class="field"><option value="">All projects</option></select><select id="priorityFilter" class="field"><option value="">All priorities</option><option>Critical</option><option>High</option><option>Medium</option><option>Low</option></select></div></header>
<main class="wrap"><section class="metrics"><div class="metric"><span>Open</span><b id="mOpen">0</b></div><div class="metric"><span>Active</span><b id="mActive">0</b></div><div class="metric"><span>Blocked</span><b id="mBlocked">0</b></div><div class="metric"><span>Critical</span><b id="mCritical">0</b></div><div class="metric"><span>Overdue</span><b id="mOverdue">0</b></div><div class="metric"><span>AI running</span><b id="mAI">0</b></div><div class="metric"><span>Done</span><b id="mDone">0%</b></div></section>
<section id="portfolio" class="view active"><div id="projects" class="projects"></div></section>
<section id="board" class="view"><div class="boardscroll"><div id="boardGrid" class="board"></div></div></section>
<section id="intelligence" class="view"><div class="intelgrid"><div class="panel"><h2>Priority engine · work next</h2><div id="ranking"></div><div id="method" class="small"></div></div><aside class="panel"><h2>Executive signals</h2><div class="signals"><div class="signal"><b id="sBlocked">0</b><span>Blocked</span></div><div class="signal"><b id="sCritical">0</b><span>Critical</span></div><div class="signal"><b id="sOverdue">0</b><span>Overdue</span></div><div class="signal"><b id="sUnassigned">0</b><span>Unassigned</span></div></div></aside></div></section>
<section id="ai" class="view"><div class="ai-layout"><div class="panel chatbox"><div class="between"><div><h2>PROJECT_BYTE AI</h2><div class="small">Talk through a project, draft an execution prompt, troubleshoot, or queue approved work.</div></div><button id="loadChat" class="mini authonly">Reload context</button></div><div id="chatlog" class="chatlog"></div><div class="grid3" style="margin-top:9px"><label class="label">Project<select id="aiProject"></select></label><label class="label">Task<select id="aiTask"><option value="">No task selected</option></select></label><label class="label">Agent<select id="aiAgent"></select></label><label class="label">Model<select id="aiModel"></select></label><div class="wide flex"><button id="draftPrompt" class="btn authonly">Draft execution prompt</button><button id="queueSelected" class="btn primary authonly">Queue selected task to AI</button><button id="askHelp" class="btn authonly">Ask Help Agent</button></div></div><div class="composer"><textarea id="chatInput" class="field" placeholder="Ask about the selected project/task…"></textarea><button id="sendChat" class="btn primary authonly">Send</button></div></div><aside class="panel"><h2>Selected context</h2><div id="contextSummary" class="small">Choose a project/task.</div><hr style="border-color:var(--line);border-width:1px 0 0;margin:12px 0"><h2>Queue discipline</h2><div class="small">Chat never launches code by itself. Queue to AI creates the approved GitHub [OC] issue, then your VPS bridge executes it in an isolated worktree and creates a PR. No auto-merge.</div></aside></div></section>
<section id="agents" class="view"><div class="between" style="margin-bottom:10px"><div><h2 style="margin:0">Agents & learning</h2><div class="small">Roles are separate from models. Execution outcomes become auditable memory and performance data.</div></div><button id="addMemory" class="btn authonly">+ Memory</button></div><div id="agentGrid" class="agentgrid"></div><div class="grid2" style="margin-top:12px"><div class="panel"><h2>Live / recent runs</h2><div id="runList" class="runlist"></div></div><div class="panel"><h2>Memory & learning</h2><div id="memoryList"></div></div></div></section>
<section id="terminalView" class="view"><div class="panel"><div class="terminaltop"><select id="terminalRun" class="field"><option value="">Select an agent run</option></select><button id="terminalRefresh" class="btn authonly">Refresh terminal</button><a id="terminalIssue" class="btn" target="_blank" rel="noopener" style="display:none">Issue</a><a id="terminalPR" class="btn" target="_blank" rel="noopener" style="display:none">PR</a></div><div class="small" style="margin-bottom:8px">Read-only execution view. This shows the bridge/OpenCode log and run events; it is intentionally not an unrestricted server shell.</div><pre id="terminal" class="terminal">Select a run to inspect execution.</pre></div></section>
<section id="models" class="view"><div class="between" st