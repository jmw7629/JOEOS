="mini adminonly" data-test-model="${esc(m.model_key)}">Test connection</button></article>`}).join('')}
function renderTeam(){$('#teamGrid').innerHTML=team.map(p=>`<article class="teamcard"><div class="cardhead"><div><h3>${esc(p.name)}</h3><div class="small">${esc(p.role)}</div></div><span class="pill">${p.active?'Active':'Revoked'}</span></div><div class="small">Last seen: ${p.last_seen?new Date(p.last_seen*1000).toLocaleString():'Never'}</div><button class="mini adminonly" data-toggle-person="${esc(p.id)}" data-active="${p.active?0:1}" data-role="${esc(p.role)}">${p.active?'Revoke':'Restore'}</button></article>`).join('')||'<div class="panel">No collaborators yet.</div>'}
function renderActivity(){$('#activityList').innerHTML=activity.map(x=>`<div class="event"><time>${new Date(x.ts*1000).toLocaleString()}</time><div class="kind">${esc(x.action)}</div><div><b>${esc(x.actor||'system')}</b>${x.project?' · '+esc(x.project):''}${x.detail?' · '+esc(x.detail):''}</div></div>`).join('')||'<div class="panel">No activity yet.</div>'}
function renderAll(){setSession();renderMetrics();renderProjects();renderBoard();renderIntel();renderAgents();renderModels();renderTeam();renderActivity();syncAIContext()}
async function patchTask(id,d){try{await api('/api/tasks/'+id,{method:'PATCH',body:JSON.stringify(d)});await load()}catch(e){$('#status').textContent=e.message}}
function move(t,d){const i=S.indexOf(t.status),n=Math.max(0,Math.min(S.length-1,i+d));if(n!==i)patchTask(t.id,{status:S[n]})}
function openModal(id){$('#'+id).classList.add('open')}function closeModal(id){$('#'+id).classList.remove('open')}
function fillDeps(current){$('#taskDependency').innerHTML='<option value="">None</option>'+tasks.filter(t=>t.id!==current).map(t=>`<option value="${esc(t.id)}">${esc(t.title)}</option>`).join('')}
function openTask(id=''){const t=tasks.find(x=>x.id===id);$('#taskForm').reset();$('#taskId').value=t?.id||'';$('#taskModalTitle').textContent=t?'Work item':'New work item';$('#taskTitle').value=t?.title||'';$('#taskProject').value=t?.project||$('#projectFilter').value||'';$('#taskStatus').value=t?.status||'Backlog';$('#taskPriority').value=t?.priority||'Medium';$('#taskProgress').value=t?.progress||0;$('#taskDue').value=t?.due_date||'';$('#taskMilestone').value=t?.milestone||'';$('#taskOwner').value=t?.owner||'';$('#taskUrl').value=t?.url||'';$('#taskExecutor').value=t?.executor||'human';$('#taskAgent').value=t?.agent_key||'';$('#taskModel').value=t?.model_key||'';$('#taskNote').value=t?.note||'';$('#taskPrompt').value=t?.ai_prompt||'';fillDeps(t?.id||'');$('#taskDependency').value=t?.depends_on||'';$('#deleteTask').style.display=t?'inline-flex':'none';$('#queueTask').style.display=t?'inline-flex':'none';$('#fileSection').style.display=t?'block':'none';$('#fileList').innerHTML=(t?.attachments||[]).map(f=>`<div class="fileitem"><a href="${esc(f.url)}" target="_blank">${esc(f.original_name)}</a></div>`).join('')||'<div class="small">No attachments.</div>';openModal('taskModal')}
function openProject(name){const p=projects.find(x=>x.name===name);if(!p)return;$('#projectName').value=p.name;$('#projectModalTitle').textContent=p.name;$('#projectHealth').value=p.health;$('#projectStage').value=p.stage||'';$('#projectLead').value=p.lead||'';$('#projectTarget').value=p.target_date||'';$('#projectRepo').value=p.repo||'';$('#projectLive').value=p.live_url||'';$('#projectGoal').value=p.goal||'';$('#projectNotes').value=p.notes||'';openModal('projectModal')}
function syncAITasks(){const p=$('#aiProject').value;const arr=tasks.filter(t=>!p||t.project===p);const cur=$('#aiTask').value;$('#aiTask').innerHTML='<option value="">No task selected</option>'+arr.map(t=>`<option value="${esc(t.id)}">${esc(t.title)}</option>`).join('');if(arr.some(t=>t.id===cur))$('#aiTask').value=cur}
function syncAIContext(){const p=$('#aiProject').value,t=tasks.find(x=>x.id===$('#aiTask').value);$('#contextSummary').innerHTML=`<b>Project:</b> ${esc(p||'none')}<br><b>Task:</b> ${esc(t?.title||'none')}<br><b>Status:</b> ${esc(t?.status||'—')}<br><b>Priority:</b> ${esc(t?.priority||'—')}<br><b>AI state:</b> ${esc(t?.ai_state||'—')}`}
async function loadChat(){if(session.level<2)return;const p=$('#aiProject').value,t=$('#aiTask').value;try{const x=await api('/api/chat?project='+encodeURIComponent(p)+'&task='+encodeURIComponent(t));$('#chatlog').innerHTML=x.messages.map(m=>`<div class="msg ${esc(m.role)}"><b>${esc(m.actor)}</b><br>${esc(m.content)}</div>`).join('');$('#chatlog').scrollTop=$('#chatlog').scrollHeight}catch(e){$('#status').textContent=e.message}}
async function sendChat(textOverride=''){const text=textOverride||$('#chatInput').value.trim();if(!text)return;try{$('#sendChat').disabled=true;const x=await api('/api/chat',{method:'POST',body:JSON.stringify({message:text,project:$('#aiProject').value,task_id:$('#aiTask').value,agent_key:$('#aiAgent').value||'executive',model_key:$('#aiModel').value})});$('#chatInput').value='';await loadChat();$('#status').textContent=`AI answered via ${x.model_key} in ${x.latency_ms} ms`}catch(e){$('#status').textContent='AI: '+e.message}finally{$('#sendChat').disabled=false}}
async function queue(id,prompt=''){const t=tasks.find(x=>x.id===id);if(!t)return;try{const x=await api('/api/tasks/'+id+'/queue',{method:'POST',body:JSON.stringify({agent_key:$('#aiAgent').value||t.agent_key||'builder',model_key:$('#aiModel').value||t.model_key||'',prompt:prompt||t.ai_prompt||''})});$('#status').textContent='Queued: '+x.issue_url;await load()}catch(e){$('#status').textContent='Queue blocked: '+e.message}}
async function terminalLoad(){const id=$('#terminalRun').value;if(!id){$('#terminal').textContent='Select a run to inspect execution.';return}try{const x=await api('/api/runs/'+id+'/terminal');$('#terminal').textContent=(x.lines||[]).join('\n')||'[No local bridge log yet. Run may still be queued.]';$('#terminalIssue').style.display=x.issue_url?'inline-flex':'none';$('#terminalIssue').href=x.issue_url||'#';$('#terminalPR').style.display=x.pr_url?'inline-flex':'none';$('#terminalPR').href=x.pr_url||'#'}catch(e){$('#terminal').textContent=e.message}}
$('#login').onclick=async()=>{if(session.ok){accessKey='';sessionStorage.removeItem('project_byte_access');await load();return}const k=prompt('Enter PROJECT_BYTE owner or collaborator access key');if(!k)return;accessKey=k.trim();try{await api('/api/auth',{method:'POST',body:'{}'});sessionStorage.setItem('project_byte_access',accessKey);await load()}catch(e){accessKey='';sessionStorage.removeItem('project_byte_access');$('#status').textContent='Invalid or locked access key.'}};
$('#taskForm').onsubmit=async e=>{e.preventDefault();if(session.level<2)return;const id=$('#taskId').value,d={title:$('#taskTitle').value,project:$('#taskProject').value,status:$('#taskStatus').value,priority:$('#taskPriority').value,progress:Number($('#taskProgress').value||0),due_date:$('#taskDue').value,milestone:$('#taskMilestone').value,owner:$('#taskOwner').value,depe