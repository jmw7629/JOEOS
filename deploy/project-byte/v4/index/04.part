l">Health<select id="projectHealth"><option>On track</option><option>At risk</option><option>Blocked</option><option>Paused</option></select></label><label class="label">Stage<input id="projectStage"></label><label class="label">Lead<input id="projectLead"></label><label class="label">Target date<input id="projectTarget" type="date"></label><label class="label wide">Repository<input id="projectRepo" placeholder="owner/repo"></label><label class="label wide">Live URL<input id="projectLive" type="url"></label><label class="label wide">Goal<textarea id="projectGoal"></textarea></label><label class="label wide">Executive notes<textarea id="projectNotes"></textarea></label></div><div class="row"><button type="button" class="btn" data-close="projectModal">Cancel</button><button class="btn primary authonly">Save project</button></div></form></div>
<div id="modelModal" class="modalwrap"><form id="modelForm" class="modal"><h2>Connect model</h2><div class="grid2"><label class="label">Key<input id="modelKey" placeholder="provider/model" required></label><label class="label">Display name<input id="modelName" required></label><label class="label">Provider<select id="modelProvider"><option value="ollama">Ollama</option><option value="openai-responses">OpenAI Responses</option></select></label><label class="label">Model name<input id="modelModel" placeholder="qwen... or gpt-5.6-sol"></label><label class="label wide">Endpoint<input id="modelEndpoint" placeholder="http://127.0.0.1:11434"></label><label class="label wide">Server secret environment variable<input id="modelSecret" placeholder="PROJECT_BYTE_OPENAI_API_KEY"></label><label class="label wide">Capabilities (comma-separated)<input id="modelCaps" placeholder="coding, reasoning, vision"></label><label class="label wide">Notes<textarea id="modelNotes"></textarea></label></div><div class="row"><button type="button" class="btn" data-close="modelModal">Cancel</button><button class="btn primary">Connect</button></div></form></div>
<div id="personModal" class="modalwrap"><form id="personForm" class="modal"><h2>Add collaborator</h2><div class="grid2"><label class="label">Name<input id="personName" required></label><label class="label">Role<select id="personRole"><option>viewer</option><option selected>editor</option><option>admin</option></select></label></div><div class="small" style="margin-top:10px">A strong one-time key will be shown once. PROJECT_BYTE stores only its hash.</div><div class="row"><button type="button" class="btn" data-close="personModal">Cancel</button><button class="btn primary">Create access</button></div></form></div>
<div id="memoryModal" class="modalwrap"><form id="memoryForm" class="modal"><h2>Add agent memory</h2><div class="grid2"><label class="label">Agent<select id="memoryAgent"></select></label><label class="label">Project<select id="memoryProject"></select></label><label class="label">Kind<select id="memoryKind"><option>decision</option><option>preference</option><option>constraint</option><option>lesson</option><option>pattern</option></select></label><label class="label">Confidence<input id="memoryConfidence" type="number" min="0" max="1" step=".1" value="0.8"></label><label class="label wide">Memory<textarea id="memoryContent" required></textarea></label></div><div class="row"><button type="button" class="btn" data-close="memoryModal">Cancel</button><button class="btn primary">Save memory</button></div></form></div>
<script>
const S=['Backlog','Active','Blocked','Review','Done'];let tasks=[],projects=[],models=[],agents=[],runs=[],activity=[],team=[],memory=[],notifications=[],intel={top:[],signals:{}},settings={general:{default_view:'portfolio',default_project:'',refresh_seconds:10,density:'comfortable',show_completed:true,reduced_motion:false,large_text:false,timezone:'America/New_York'},notifications:{},ai:{default_agent:'executive',default_model:'',confirm_queue:true,auto_terminal:true},security:{session_minutes:480},filters:{saved_views:[],default_saved_view:''}};let accessKey=sessionStorage.getItem('project_byte_access')||'';let session={ok:false,level:0,name:'Public',role:'public',subject:''};let refreshTimer=null,lastBrowserNotice=Number(localStorage.getItem('pb_last_notice')||0);const $=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const FILTER_IDS=['projectFilter','ownerFilter','priorityFilter','leadFilter','statusFilter','healthFilter','stageFilter','executorFilter','agentFilter','modelFilter','aiStateFilter','dueFilter','completionFilter','dependencyFilter','activityFilter','milestoneFilter','repoFilter','runFilter','scopeFilter'];
async function api(url,opt={}){const h={...(opt.headers||{})};if(!(opt.body instanceof Blob))h['Content-Type']='application/json';if(accessKey)h['X-Access-Key']=accessKey;const r=await fetch(url,{...opt,headers:h});if(!r.ok){let x={};try{x=await r.json()}catch{}throw new Error(x.error||r.statusText)}const ct=r.headers.get('content-type')||'';return ct.includes('json')?r.json():r.text()}
function setSession(){document.body.classList.toggle('auth',session.level>=2);document.body.classList.toggle('admin',session.level>=3);document.body.classList.toggle('signedin',session.level>=1);$('#login').textContent=session.ok?`${session.name} · ${session.role}`:'Owner / Team login';if($('#currentAccess'))$('#currentAccess').value=session.ok?`${session.name} · ${session.role}`:'Public'}
function applyAppearance(){document.body.classList.toggle('compact',settings.general?.density==='compact');document.body.classList.toggle('large-text',!!settings.general?.large_text);document.body.classList.toggle('reduced-motion',!!settings.general?.reduced_motion)}
async function loadNotifications(){if(session.level<1){notifications=[];renderNotifications();return}try{notifications=(await api('/api/notifications')).notifications||[];renderNotifications();deliverBrowserNotifications()}catch(e){notifications=[]}}
async function load(){try{const calls=[api('/api/session'),api('/api/tasks'),api('/api/projects'),api('/api/intelligence'),api('/api/activity'),api('/api/models'),api('/api/agents'),api('/api/runs')];const [ss,a,b,c,d,e,f,g]=await Promise.all(calls);session=ss;tasks=a.tasks;projects=b.projects;intel=c;activity=d.activity;models=e.models;agents=f.agents;runs=g.runs;if(session.level>=1){try{settings=(await api('/api/settings')).settings}catch{};applyAppearance()}if(session.level>=3){try{team=(await api('/api/team')).team}catch{team=[]}}else team=[];if(session.level>=2){try{memory=(await api('/api/memory')).memory}catch{memory=[]}}else memory=[];syncSelectors();applySettingsForm();renderAll();await loadNotifications();setRefreshTimer();$('#status').textContent=`Live · ${session.ok?session.name:'public read-only'} · ${new Date().toLocaleTimeString()}`}catch(e){$('#status').textContent='Load error: '+e.message}}
function setOptions(id,values,label,formatter=x=>x){const el=$('#'+id);if(!el)return;const cur=el.value;el.innerHTML=`<option value="">${label}</option>`+values.filter(Boolean).map(x=>`<option value="${esc(x)}">${esc(formatter(x))}</option>`).join('');if(values.includes(cur))el.value=cur}
function syncSelectors(){const ps=[...new Set([...projects.map(p=>p.name),...tasks.map(t=>t.project)])].sort();setOptions('projectFilter',ps,'All projects');setOptions('ownerFilter',[...new Set([...tasks.map(t=>t.owner),...team.map(x=>x.name),session.name==='Public'?'':session.name])].filter(Boolean).sort(),'All task owners');setOptions('leadFilter',[...new Set([...projects.map(p=>p.lead),...team.map(x=>x.name),session.name==='Public'?'':session.name])].filter(Boolean).sort(),'All leads');setOptions('stageFilter',[...new Set(projects.map(p=>p.stage).filter(Boolean))].sort(),'All stages');setOptions('milestoneFilter',[...new Set(tasks.map(t=>t.milestone).filter(Boolean))].sort(),'All milestones');setOptions('repoFilter',[...new Set(projects.map(p=>p.repo).filter(Boolean))].sort(),'All repositories');setOptions('agentFilter',agents.filter(a=>a.enabled).map(a=>a.agent_key),'All agents',x=>(agents.find(a=>a.agent_key===x)?.name||x));setOptions('modelFilter',models.filter(m=>m.enabled).map(m=>m.model_key),'All models',x=>(models.find(m=>m.model_key===x)?.display_name||x));$('#projectNames').innerHTML=ps.map(x=>`<option value="${esc(x)}">`).join('');for(const id of ['aiProject','memoryProject']){$('#'+id).innerHTML='<option value="">Select project</option>'+ps.map(x=>`<option>${esc(x)}</option>`).join('')}const agentOpts='<option value="">Auto-route</option>'+agents.filter(a=>a.enabled).map(a=>`<option value="${esc(a.agent_key)}">${esc(a.name)} · ${esc(a.role)}</option>`).join('');for(const id of ['aiAgent','taskAgent','memoryAgent','setDefaultAgent'])if($('#'+id))$('#'+id).innerHTML=agentOpts;const modelOpts='<option value="">Auto-route</option>'+models.filter(m=>m.enabled).map(m=>`<option value="${esc(m.model_key)}">${esc(m.display_name)}</option>`).join('');for(const id of ['aiModel','taskModel','setDefaultModel'])if($('#'+id))$('#'+id).innerHTML=modelOpts;$('#setDefaultProject').innerHTML='<option value="">All projects</option>'+ps.map(x=>`<option>${esc(x)}</option>`).join('');syncAITasks();$('#terminalRun').innerHTML='<option value="">Select an agent run</option>'+runs.map(r=>`<option value="${esc(r.id)}">${esc(r.project)} · #${r.issue_number} · ${esc(r.status)}</option>`).join('');syncSavedViews()}
function filterCriteria(){const o={search:$('#search').value.trim()};for(const id of FILTER_IDS)o[id]=$('#'+id)?.value||'';return o}
function applyCriteria(c={}){$('#search').value=c.search||'';for(const id of FILTER_IDS)if($('#'+id))$('#'+id).value=c[id]||'';renderAll()}
function projectFor(t){return projects.find(p=>p.name===t.project)||{}}
function daysUntil(v){if(!v)return null;const d=new Date(v+'T12:00:00'),n=new Date();n.setHours(12,0,0,0);return Math.round((d-n)/86400000)}
function visible(){const c=filterCriteria(),q=c.search.toLowerCase(),by=Object.fromEntries(tasks.map(t=>[t.id,t]));return tasks.filter(t=>{const p=projectFor(t);if(!settings.general?.show_completed&&t.status==='Done'&&!c.completionFilter)return false;if(c.projectFilter&&t.project!==c.projectFilter)return false;if(c.ownerFilter&&t.owner!==c.ownerFilter)return false;if(c.priorityFilter&&t.priority!==c.priorityFilter)return false;if(c.leadFilter&&p.lead!==c.leadFilter)return false;if(c.statusFilter&&t.status!==c.statusFilter)return false;if(c.healthFilter&&p.health!==c.healthFilter)return false;if(c.stageFilter&&p.stage!==c.stageFilter)return false;if(c.executorFilter&&(t.executor||'human')!==c.executorFilter)return false;if(c.agentFilter&&t.agent_key!==c.agentFilter)return false;if(c.modelFilter&&t.model_key!==c.modelFilter)return false;if(c.aiStateFilter&&t.ai_state!==c.aiStateFilter)return false;if(c.milestoneFilter&&t.milestone!==c.milestoneFilter)return false;if(c.repoFilter&&p.repo!==c.repoFilter)return false;if(c.completionFilter==='open'&&t.status==='Done')return false;if(c.completionFilter==='done'&&t.status!=='Done')return false;const du=daysUntil(t.due_date);if(c.dueFilter==='overdue'&&!(du!==null&&du<0))return false;if(c.dueFilter==='today'&&du!==0)return false;if(c.dueFilter==='2d'&&!(du!==null&&du>=0&&du<=2))return false;if(c.dueFilter==='7d'&&!(du!==null&&du>=0&&du<=7))return false;if(c.dueFilter==='30d'&&!(du!==null&&du>=0&&du<=30))return false;if(c.dueFilter==='none'&&t.due_date)return false;const dep=t.depends_on&&by[t.depends_on],blocked=!!(dep&&dep.status!=='Done'),unlocks=tasks.some(x=>x.depends_on===t.id&&x.status!=='Done');if(c.dependencyFilter==='blocked'&&!blocked)return false;if(c.dependencyFilter==='unlocks'&&!unlocks)return false;if(c.dependencyFilter==='has'&&!t.depends_on)return false;if(c.dependencyFilter==='none'&&t.depends_on)return false;const age=(Date.now()/1000-Number(t.updated_at||0))/86400;if(c.activityFilter==='24h'&&age>1)return false;if(c.activityFilter==='7d'&&age>7)return false;if(c.activityFilter==='stale'&&age<=7)return false;const rr=t.last_run_id?runs.find(r=>r.id===t.last_run_id):null;if(c.runFilter==='active'&&!(rr&&['queued','running'].includes(rr.status)))return false;if(c.runFilter==='none'&&rr)return false;if(c.runFilter==='finished'&&!(rr&&!['queued','running'].includes(rr.status)))return false;if(c.scopeFilter==='mine'&&!(t.owner===session.name||p.lead===session.name))return false;if(c.scopeFilter==='unassigned'&&t.owner)return false;if(q&&![t.title,t.project,t.note,t.milestone,t.owner,t.status,t.priority,t.ai_state,t.agent_key,t.model_key,p.lead,p.health,p.stage,p.repo].join(' ').toLowerCase().includes(q))return false;return true})}
function activeFilterCount(){const c=filterCriteria();return Object.entries(c).filter(([k,v])=>k!=='search'&&v).length+(c.search?1:0)}
function renderFilterState(){const n=activeFilterCount();$('#filterCount').textContent=n||'';$('#activeFilterSummary').textContent=n?`${n} active filter${n===1?'':'s'} · ${visible().length} tasks match`:`${visible().length} tasks · all scopes`;$('#advancedFilters').classList.toggle('open',n>4||$('#advancedFilters').classList.contains('open'))}
function renderMetrics(){const scoped=visible(),o=scoped.filter(t=>t.status!=='Done'),today=new Date().toISOString().slice(0,10);$('#mOpen