').textContent=o.length;$('#mActive').textContent=scoped.filter(t=>t.status==='Active').length;$('#mBlocked').textContent=scoped.filter(t=>t.status==='Blocked').length;$('#mCritical').textContent=o.filter(t=>t.priority==='Critical').length;$('#mOverdue').textContent=o.filter(t=>t.due_date&&t.due_date<today).length;const ids=new Set(scoped.map(t=>t.id));$('#mAI').textContent=runs.filter(r=>ids.has(r.task_id)&&['queued','running'].includes(r.status)).length;$('#mDone').textContent=(scoped.length?Math.round(scoped.filter(t=>t.status==='Done').length/scoped.length*100):0)+'%'}
function projectMatches(p,v){const c=filterCriteria(),q=c.search.toLowerCase();if(c.projectFilter&&p.name!==c.projectFilter)return false;if(c.leadFilter&&p.lead!==c.leadFilter)return false;if(c.healthFilter&&p.health!==c.healthFilter)return false;if(c.stageFilter&&p.stage!==c.stageFilter)return false;if(c.repoFilter&&p.repo!==c.repoFilter)return false;if(c.scopeFilter==='mine'&&p.lead!==session.name&&!v.some(t=>t.project===p.name&&t.owner===session.name))return false;const taskScoped=['ownerFilter','priorityFilter','statusFilter','executorFilter','agentFilter','modelFilter','aiStateFilter','dueFilter','completionFilter','dependencyFilter','activityFilter','milestoneFilter','runFilter'].some(k=>c[k]);if(taskScoped&&!v.some(t=>t.project===p.name))return false;if(q&&![p.name,p.goal,p.notes,p.repo,p.lead,p.stage,p.health].join(' ').toLowerCase().includes(q)&&!v.some(t=>t.project===p.name))return false;return true}
function renderProjects(){const v=visible(),list=projects.filter(p=>projectMatches(p,v));$('#projects').innerHTML='';for(const p of list){const all=tasks.filter(t=>t.project===p.name),shown=v.filter(t=>t.project===p.name),done=all.filter(t=>t.status==='Done').length,prog=all.length?Math.round(all.reduce((a,t)=>a+(t.status==='Done'?100:Number(t.progress||0)),0)/all.length):0,activeRuns=runs.filter(r=>r.project===p.name&&['queued','running'].includes(r.status)).length;const el=document.createElement('article');el.className='project';el.innerHTML=`<div class="projecthead"><h2>${esc(p.name)}</h2><span class="health" data-h="${esc(p.health)}">${esc(p.health)}</span></div><div class="goal">${esc(p.goal||'No project goal defined yet.')}</div><div class="between meta"><span>${esc(p.stage||'Build')} · Lead ${esc(p.lead||'—')}</span><span>${prog}%</span></div><div class="bar"><i style="width:${prog}%"></i></div><div class="between meta"><span>${all.length-done} open · ${activeRuns} AI active${activeFilterCount()?` · ${shown.length} match`:''}</span><span>Target ${esc(p.target_date||'—')}</span></div><div class="flex" style="margin-top:9px">${p.live_url?`<a class="mini" href="${esc(p.live_url)}" target="_blank">Live</a>`:''}${p.repo?`<a class="mini" href="https://github.com/${esc(p.repo)}" target="_blank">GitHub</a>`:''}<button class="mini" data-focus="${esc(p.name)}">Open board</button><button class="mini authonly" data-edit-project="${esc(p.name)}">Edit</button><button class="mini" data-ai-project="${esc(p.name)}">Ask AI</button><button class="mini" data-lead="${esc(p.lead||'')}">Lead view</button></div>`;$('#projects').append(el)}if(!list.length)$('#projects').innerHTML='<div class="panel">No projects match the current filter scope.</div>'}
function card(t){const e=document.createElement('article');e.className='task';e.dataset.p=t.priority;const ai=t.ai_state?`<span class="tag">AI ${esc(t.ai_state)}</span>`:'';const lead=projectFor(t).lead||'';e.innerHTML=`<h3>${esc(t.title)}</h3><div class="flex"><span class="tag">${esc(t.project)}</span><span class="tag">${esc(t.priority)}</span>${t.due_date?`<span class="tag">Due ${esc(t.due_date)}</span>`:''}${t.milestone?`<span class="tag">${esc(t.milestone)}</span>`:''}${ai}</div><div class="tasknote">${esc(t.note||'No next action specified.')}</div><div class="between meta"><span>${Number(t.progress||0)}%</span><span>${esc(t.owner||'Unassigned')}${lead&&lead!==t.owner?' · Lead '+esc(lead):''}</span></div><div class="bar"><i style="width:${Math.max(0,Math.min(100,Number(t.progress||0)))}%"></i></div>`;const a=document.createElement('div');a.className='taskactions';let l=document.createElement('button');l.textContent='←';let s=document.createElement('select');S.forEach(x=>s.add(new Option(x,x)));s.value=t.status;let r=document.createElement('button');r.textContent='→';let d=document.createElement('button');d.textContent='•••';l.disabled=session.level<2||S.indexOf(t.status)===0;r.disabled=session.level<2||S.indexOf(t.status)===S.length-1;s.disabled=session.level<2;l.onclick=()=>move(t,-1);r.onclick=()=>move(t,1);s.onchange=()=>patchTask(t.id,{status:s.value});d.onclick=()=>openTask(t.id);a.append(l,s,r,d);e.append(a);return e}
function renderBoard(){const v=visible();$('#boardGrid').innerHTML='';for(const st of S){const c=document.createElement('section');c.className='col';const items=v.filter(t=>t.status===st);c.innerHTML=`<div class="colhead"><span>${st}</span><span class="pill">${items.length}</span></div>`;items.forEach(t=>c.append(card(t)));$('#boardGrid').append(c)}}
function localScore(t){let x={Critical:50,High:35,Medium:20,Low:10}[t.priority]||0;x+=({Blocked:20,Active:15,Review:10,Backlog:5}[t.status]||0);x+=({Blocked:20,'At risk':10,Paused:-10}[projectFor(t).health]||0);const d=daysUntil(t.due_date);if(d!==null)x+=d<0?35:d<=2?30:d<=7?20:d<=14?10:0;const dep=t.depends_on&&tasks.find(a=>a.id===t.depends_on);if(dep&&dep.status!=='Done')x-=35;x+=tasks.filter(a=>a.depends_on===t.id&&a.status!=='Done').length*8;const pr=Number(t.progress||0);x+=pr>=75?6:pr>=50?3:0;return x}
function renderIntel(){const ranked=visible().filter(t=>t.status!=='Done').map(t=>({...t,score:localScore(t),dependency_title:(tasks.find(x=>x.id===t.depends_on)||{}).title||''})).sort((a,b)=>b.score-a.score||(a.due_date||'9999').localeCompare(b.due_date||'9999')).slice(0,20);$('#ranking').innerHTML=ranked.map((t,i)=>`<div class="priorityrow"><div class="score">${i+1}</div><div><b>${esc(t.title)}</b><div class="small">${esc(t.project)} · ${esc(t.priority)} · score ${t.score}${t.dependency_title?' · waits on '+esc(t.dependency_title):''}</div></div><button class="mini" data-open-task="${esc(t.id)}">Open</button></div>`).join('')||'<div class="small">No open work in this filter scope.</div>';$('#method').textContent=(intel.method||'')+(activeFilterCount()?' · Ranking limited to current filter scope.':'');const o=visible().filter(t=>t.status!=='Done'),today=new Date().toISOString().slice(0,10);$('#sBlocked').textContent=o.filter(t=>t.status==='Blocked').length;$('#sCritical').textContent=o.filter(t=>t.priority==='Critical').length;$('#sOverdue').textContent=o.filter(t=>t.due_date&&t.due_date<today).length;$('#sUnassigned').textContent=o.filter(t=>!t.owner).length}
function renderAgents(){const ids=new Set(visible().map(t=>t.id)),filteredRuns=runs.filter(r=>!activeFilterCount()||ids.has(r.task_id));const selectedAgent=$('#agentFilter').value;$('#agentGrid').innerHTML=agents.filter(a=>!selectedAgent||a.agent_key===selectedAgent).map(a=>{const total=a.success_count+a.failure_count,rate=total?Math.round(a.success_count/total*100):0;return `<article class="agentcard"><div class="cardhead"><div><h3>${esc(a.name)}</h3><div class="small">${esc(a.role)}</div></div><span class="pill">${a.enabled?'Enabled':'Disabled'}</span></div><p class="small">${esc(a.description)}</p><div class="flex"><span class="tag">Model ${esc(a.preferred_model||'auto')}</span><span class="tag">Memory ${a.memory_enabled?'on':'off'}</span><span class="tag">Learning ${a.learning_enabled?'on':'off'}</span></div><div class="small" style="margin-top:8px">${total?rate+'% success across '+total+' learned runs':'No learned runs yet'}</div></article>`}).join('');$('#runList').innerHTML=filteredRuns.slice(0,40).map(r=>`<div class="run"><div><b>${esc(r.project)}</b> · ${esc(r.agent_key||'agent')}<div class="small">Issue #${r.issue_number} · model ${esc(r.model_key||'bridge-default')}</div></div><div><span class="status ${esc(r.status)}">${esc(r.status)}</span><br><button class="mini" data-terminal-run="${esc(r.id)}">Terminal</button></div></div>`).join('')||'<div class="small">No runs in this filter scope.</div>';const mp=$('#projectFilter').value;$('#memoryList').innerHTML=memory.filter(m=>!mp||m.project===mp).slice(0,50).map(m=>`<div class="memory"><b>${esc(m.kind)}</b> · ${esc(m.agent_key||'all agents')}<div>${esc(m.content)}</div><div class="small">${esc(m.project||'global')} · confidence ${m.confidence}</div></div>`).join('')||'<div class="small">No stored memory in this scope.</div>'}
function inQuietHours(){const n=settings.notifications||{};if(!n.quiet_enabled)return false;const nowv=new Date(),cur=nowv.getHours()*60+nowv.getMinutes(),p=s=>{const [h,m]=String(s||'00:00').split(':').map(Number);return h*60+m},a=p(n.quiet_start),b=p(n.quiet_end);return a<=b?cur>=a&&cur<b:cur>=a||cur<b}
function renderNotifications(){const unread=notifications.filter(n=>n.unread).length;$('#notifyBadge').textContent=settings.notifications?.in_app===false?'':(unread||'');if($('#unreadCount'))$('#unreadCount').textContent=unread;const box=$('#notificationList');if(!box)return;if(settings.notifications?.in_app===false){box.innerHTML='<div class="small">In-app notifications are disabled. Browser notifications can still be enabled separately.</div>';return}box.innerHTML=notifications.length?notifications.map(n=>`<div class="notice" data-s="${esc(n.severity)}"><div class="between"><b>${esc(n.title)}</b><span class="small">${new Date(n.ts*1000).toLocaleString()}</span></div><div class="small">${esc(n.message)}</div><div class="flex" style="margin-top:6px">${n.project?`<span class="tag">${esc(n.project)}</span>`:''}${n.unread?`<button class="mini" data-read-notice="${esc(n.id)}">Mark read</button>`:''}${n.link?`<button class="mini" data-notice-link="${esc(n.link)}">Open</button>`:''}</div></div>`).join(''):'<div class="small">No notifications.</div>'}
function deliverBrowserNotifications(){if(!('Notification' in window)||!settings.notifications?.browser||Notification.permission!=='granted'||inQuietHours())return;const fresh=notifications.filter(n=>n.unread&&n.ts>lastBrowserNotice).sort((a,b)=>a.ts-b.ts);for(const n of fresh.slice(-5)){try{const z=new Notification('PROJECT_BYTE · '+n.title,{body:n.message,tag:n.id});z.onclick=()=>{window.focus();if(n.link)location.hash=n.link}}catch{}}if(fresh.length){lastBrowserNotice=Math.max(...fresh.map(n=>n.ts));localStorage.setItem('pb_last_notice',String(lastBrowserNotice))}}
function renderModels(){$('#modelGrid').innerHTML=models.map(m=>{const total=m.success_count+m.failure_count,rate=total?Math.round(m.success_count/total*100):0;return `<article class="modelcard"><div class="cardhead"><div><h3>${esc(m.display_name)}</h3><div class="small">${esc(m.provider)} · ${esc(m.model_name||'auto-discover')}</div></div><span class="pill">${m.last_status==='ok'?'● Connected':'● '+esc(m.last_status)}</span></div><p class="small">${esc(m.endpoint)}</p><div class="flex"><span class="tag">key ${esc(m.model_key)}</span><span class="tag">${m.local?'Local':'Cloud'}</span><span class="tag">${m.last_latency_ms||0} ms</span><span class="tag">${total?rate+'% success':'No run data'}</span></div><p class="small">${esc(m.notes)}</p><button class