').length;$('#mBlocked').textContent=tasks.filter(t=>t.status==='Blocked').length;$('#mCritical').textContent=o.filter(t=>t.priority==='Critical').length;$('#mOverdue').textContent=o.filter(t=>t.due_date&&t.due_date<today).length;$('#mAI').textContent=runs.filter(r=>['queued','running'].includes(r.status)).length;$('#mDone').textContent=(tasks.length?Math.round(tasks.filter(t=>t.status==='Done').length/tasks.length*100):0)+'%'}
function renderProjects(){const v=visible(),pf=$('#projectFilter').value,q=$('#search').value.toLowerCase();const list=projects.filter(p=>(!pf||p.name===pf)&&(!q||[p.name,p.goal,p.notes,p.repo,p.lead,p.stage].join(' ').toLowerCase().includes(q)||v.some(t=>t.project===p.name)));$('#projects').innerHTML='';for(const p of list){const all=tasks.filter(t=>t.project===p.name),done=all.filter(t=>t.status==='Done').length,prog=all.length?Math.round(all.reduce((a,t)=>a+(t.status==='Done'?100:Number(t.progress||0)),0)/all.length):0,activeRuns=runs.filter(r=>r.project===p.name&&['queued','running'].includes(r.status)).length;const el=document.createElement('article');el.className='project';el.innerHTML=`<div class="projecthead"><h2>${esc(p.name)}</h2><span class="health" data-h="${esc(p.health)}">${esc(p.health)}</span></div><div class="goal">${esc(p.goal||'No project goal defined yet.')}</div><div class="between meta"><span>${esc(p.stage||'Build')} · Lead ${esc(p.lead||'—')}</span><span>${prog}%</span></div><div class="bar"><i style="width:${prog}%"></i></div><div class="between meta"><span>${all.length-done} open · ${activeRuns} AI active</span><span>Target ${esc(p.target_date||'—')}</span></div><div class="flex" style="margin-top:9px">${p.live_url?`<a class="mini" href="${esc(p.live_url)}" target="_blank">Live</a>`:''}${p.repo?`<a class="mini" href="https://github.com/${esc(p.repo)}" target="_blank">GitHub</a>`:''}<button class="mini" data-focus="${esc(p.name)}">Open board</button><button class="mini authonly" data-edit-project="${esc(p.name)}">Edit</button><button class="mini" data-ai-project="${esc(p.name)}">Ask AI</button></div>`;$('#projects').append(el)}if(!list.length)$('#projects').innerHTML='<div class="panel">No projects match.</div>'}
function card(t){const e=document.createElement('article');e.className='task';e.dataset.p=t.priority;const ai=t.ai_state?`<span class="tag">AI ${esc(t.ai_state)}</span>`:'';e.innerHTML=`<h3>${esc(t.title)}</h3><div class="flex"><span class="tag">${esc(t.project)}</span><span class="tag">${esc(t.priority)}</span>${t.due_date?`<span class="tag">Due ${esc(t.due_date)}</span>`:''}${t.milestone?`<span class="tag">${esc(t.milestone)}</span>`:''}${ai}</div><div class="tasknote">${esc(t.note||'No next action specified.')}</div><div class="between meta"><span>${Number(t.progress||0)}%</span><span>${esc(t.owner||'Unassigned')}</span></div><div class="bar"><i style="width:${Math.max(0,Math.min(100,Number(t.progress||0)))}%"></i></div>`;const a=document.createElement('div');a.className='taskactions';let l=document.createElement('button');l.textContent='←';let s=document.createElement('select');S.forEach(x=>s.add(new Option(x,x)));s.value=t.status;let r=document.createElement('button');r.textContent='→';let d=document.createElement('button');d.textContent='•••';l.disabled=session.level<2||S.indexOf(t.status)===0;r.disabled=session.level<2||S.indexOf(t.status)===S.length-1;s.disabled=session.level<2;l.onclick=()=>move(t,-1);r.onclick=()=>move(t,1);s.onchange=()=>patchTask(t.id,{status:s.value});d.onclick=()=>openTask(t.id);a.append(l,s,r,d);e.append(a);return e}
function renderBoard(){const v=visible();$('#boardGrid').innerHTML='';for(const st of S){const c=document.createElement('section');c.className='col';const items=v.filter(t=>t.status===st);c.innerHTML=`<div class="colhead"><span>${st}</span><span class="pill">${items.length}</span></div>`;items.forEach(t=>c.append(card(t)));$('#boardGrid').append(c)}}
function renderIntel(){$('#ranking').innerHTML=(intel.top||[]).map((t,i)=>`<div class="priorityrow"><div class="score">${i+1}</div><div><b>${esc(t.title)}</b><div class="small">${esc(t.project)} · ${esc(t.priority)} · score ${t.score}${t.dependency_title?' · waits on '+esc(t.dependency_title):''}</div></div><button class="mini" data-open-task="${esc(t.id)}">Open</button></div>`).join('')||'<div class="small">No open work.</div>';$('#method').textContent=intel.method||'';$('#sBlocked').textContent=intel.signals?.blocked||0;$('#sCritical').textContent=intel.signals?.critical_open||0;$('#sOverdue').textContent=intel.signals?.overdue||0;$('#sUnassigned').textContent=intel.signals?.unassigned||0}
function renderAgents(){$('#agentGrid').innerHTML=agents.map(a=>{const total=a.success_count+a.failure_count,rate=total?Math.round(a.success_count/total*100):0;return `<article class="agentcard"><div class="cardhead"><div><h3>${esc(a.name)}</h3><div class="small">${esc(a.role)}</div></div><span class="pill">${a.enabled?'Enabled':'Disabled'}</span></div><p class="small">${esc(a.description)}</p><div class="flex"><span class="tag">Model ${esc(a.preferred_model||'auto')}</span><span class="tag">Memory ${a.memory_enabled?'on':'off'}</span><span class="tag">Learning ${a.learning_enabled?'on':'off'}</span></div><div class="small" style="margin-top:8px">${total?rate+'% success across '+total+' learned runs':'No learned runs yet'}</div></article>`}).join('');$('#runList').innerHTML=runs.slice(0,30).map(r=>`<div class="run"><div><b>${esc(r.project)}</b> · ${esc(r.agent_key||'agent')}<div class="small">Issue #${r.issue_number} · model ${esc(r.model_key||'bridge-default')}</div></div><div><span class="status ${esc(r.status)}">${esc(r.status)}</span><br><button class="mini" data-terminal-run="${esc(r.id)}">Terminal</button></div></div>`).join('')||'<div class="small">No runs yet.</div>';$('#memoryList').innerHTML=memory.slice(0,50).map(m=>`<div class="memory"><b>${esc(m.kind)}</b> · ${esc(m.agent_key||'all agents')}<div>${esc(m.content)}</div><div class="small">${esc(m.project||'global')} · confidence ${m.confidence}</div></div>`).join('')||'<div class="small">No stored memory yet.</div>'}
function renderModels(){$('#modelGrid').innerHTML=models.map(m=>{const total=m.success_count+m.failure_count,rate=total?Math.round(m.success_count/total*100):0;return `<article class="modelcard"><div class="cardhead"><div><h3>${esc(m.display_name)}</h3><div class="small">${esc(m.provider)} · ${esc(m.model_name||'auto-discover')}</div></div><span class="pill">${m.last_status==='ok'?'● Connected':'● '+esc(m.last_status)}</span></div><p class="small">${esc(m.endpoint)}</p><div class="flex"><span class="tag">${m.local?'Local':'Cloud'}</span><span class="tag">${m.last_latency_ms||0} ms</span><span class="tag">${total?rate+'% success':'No run data'}</span></div><p class="small">${esc(m.notes)}</p><button class="mini adminonly" data-test-model="${esc(m.model_key)}">Test connection</button></article>`}).join('')}
function renderTeam(){$('#te