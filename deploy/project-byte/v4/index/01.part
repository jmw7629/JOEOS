<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#05070c"><title>PROJECT_BYTE</title><style>
:root{--bg:#05070c;--panel:#111822;--card:#17212d;--line:#2a3747;--txt:#edf4fb;--muted:#91a1b4;--accent:#65bdf7;--accent2:#173f59;--danger:#ff7373;--warn:#efb35d;--ok:#7bd49c;--violet:#b7a2ff}*{box-sizing:border-box}html{scroll-behavior:smooth;background:#05070c}body{margin:0;min-height:100%;background:radial-gradient(circle at 18% -6%,rgba(66,106,176,.18),transparent 30%),radial-gradient(circle at 86% 5%,rgba(98,65,154,.15),transparent 34%),radial-gradient(circle at 58% 38%,rgba(28,65,112,.09),transparent 38%),linear-gradient(180deg,#05070c 0%,#080b13 44%,#05070b 100%);background-attachment:fixed;color:var(--txt);font:15px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;position:relative;isolation:isolate}body:before{content:"";position:fixed;inset:0;z-index:-2;pointer-events:none;background-image:radial-gradient(circle,rgba(255,255,255,.62) 0 .65px,transparent .8px),radial-gradient(circle,rgba(149,191,255,.5) 0 .55px,transparent .72px),radial-gradient(circle,rgba(190,167,255,.36) 0 .48px,transparent .64px);background-size:53px 53px,97px 97px,151px 151px;background-position:0 0,23px 37px,71px 19px;opacity:.42}body:after{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(ellipse at 50% 16%,rgba(47,88,153,.10),transparent 44%),radial-gradient(ellipse at 15% 68%,rgba(47,87,129,.06),transparent 34%),radial-gradient(ellipse at 88% 78%,rgba(90,62,135,.06),transparent 36%);mix-blend-mode:screen;opacity:.8}button,input,select,textarea{font:inherit}button{cursor:pointer}a{color:#9fd8ff;text-decoration:none}a:hover{text-decoration:underline}header{position:sticky;top:0;z-index:10;background:rgba(5,7,12,.9);backdrop-filter:blur(18px);border-bottom:1px solid var(--line);padding:14px 18px}.brand{display:flex;justify-content:space-between;gap:16px;align-items:flex-start}.brand h1{font-size:22px;margin:0;letter-spacing:.05em}.brand p{margin:3px 0 0;color:var(--muted);font-size:13px}.top{display:flex;gap:8px;flex-wrap:wrap}.btn,.field{background:var(--panel);border:1px solid var(--line);border-radius:10px;color:var(--txt);min-height:40px;padding:8px 11px}.btn.primary{background:var(--accent2);border-color:#2c739e}.btn.danger{border-color:#673838;color:#ffabab}.btn.good{border-color:#315d42;color:#a6ecc0}.btn:disabled{opacity:.42;cursor:not-allowed}.tabs{display:flex;gap:3px;margin-top:11px;overflow:auto}.tab{background:transparent;color:var(--muted);border:0;border-bottom:2px solid transparent;padding:9px 10px;white-space:nowrap}.tab.active{color:var(--txt);border-color:var(--accent)}.filters{display:flex;gap:8px;flex-wrap:wrap;margin-top:9px}.filters input{flex:1;min-width:210px}.wrap{padding:16px 18px 34px}.metrics{display:grid;grid-template-columns:repeat(7,minmax(95px,1fr));gap:9px;margin-bottom:14px}.metric{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:11px}.metric span{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.08em}.metric b{display:block;font-size:21px;margin-top:3px}.view{display:none}.view.active{display:block}.projects{display:grid;grid-template-columns:repeat(auto-fill,minmax(285px,1fr));gap:12px}.project,.panel,.agentcard,.modelcard,.teamcard,.helpcard{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:13px}.projecthead,.cardhead{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.project h2,.panel h2,.agentcard h3,.modelcard h3,.teamcard h3,.helpcard h3{font-size:16px;margin:0}.health,.pill,.tag{font-size:11px;border:1px solid var(--line);border-radius:999px;padding:3px 7px;color:var(--muted)}.health[data-h="At risk"]{color:var(--warn)}.health[data-h="Blocked"]{color:var(--danger)}.health[data-h="On track"]{color:var(--ok)}.goal{color:#c8d3df;font-size:13px;min-height:36px;margin:9px 0}.meta,.small{color:var(--muted);font-size:12px}.flex{display:flex;gap:7px;flex-wrap:wrap;align-items:center}.between{display:flex;justify-content:space-between;gap:8px}.bar{height:7px;background:#0b1118;border-radius:999px;overflow:hidden;margin:7px 0 9px}.bar i{display:block;height:100%;background:var(--accent)}.mini{background:transparent;border:1px solid var(--line);border-radius:8px;color:var(--txt);min-height:32px;padding:5px 8px}.boardscroll{overflow-x:auto}.board{display:grid;grid-template-columns:repeat(5,minmax(275px,1fr));gap:12px;min-width:1470px}.col{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:10px;min-height:430px}.colhead{display:flex;justify-content:space-between;padding:3px 4px 9px;font-weight:650}.task{background:var(--card);border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:12px;padding:10px;margin-bottom:9px}.task[data-p="Critical"]{border-left-color:var(--danger)}.task[data-p="High"]{border-left-color:var(--warn)}.task h3{font-size:14px;margin:0 0 7px}.tasknote{font-size:12px;color:#c5d0dc;margin:8px 0}.taskactions{display:grid;grid-template-columns:auto 1fr auto auto;gap:5px;margin-top:8px}.taskactions button,.taskactions select{background:transparent;color:var(--txt);border:1px solid var(--line);border-radius:8px;min-height:33px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.intelgrid{display:grid;grid-template-columns:minmax(0,2fr) minmax(260px,1fr);gap:12px}.priorityrow{display:grid;grid-template-columns:38px 1fr auto;gap:10px;align-items:center;padding:9px 0;border-bottom:1px solid var(--line)}.score{font-size:18px;color:var(--accent);font-weight:700}.signals{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.signal{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:9px;text-align:center}.signal b{font-size:20px;display:block}.signal span{color:var(--muted);font-size:10px;text-transform:uppercase}.ai-layout{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(280px,.8fr);gap:12px}.chatbox{min-height:460px;display:flex;flex-direction:column}.chatlog{flex:1;background:#0b1118;border:1px solid var(--line);border-radius:11px;padding:10px;min-height:330px;max-height:560px;overflow:auto}.msg{padding:9px 10px;border-radius:10px;margin:7px 0;max-width:88%;white-space:pre-wrap}.msg.user{margin-left:auto;background:#15334a}.msg.assistant{background:var(--card)}.composer{display:grid;grid-template-columns:1fr auto;gap:8px;margin-top:9px}.composer textarea{min-height:76px;resize:vertical}.agentgrid,.modelgrid,.teamgrid,.helpgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(275px,1fr));gap:12px}.runlist{display:grid;gap:8px}.run{background:var(--card);border:1px solid var(--line);border-radius:11px;padding:10px;display:grid;grid-template-columns:1fr auto;gap:8px}.status.running,.status.queued{color:var(--accent)}.status.pr-created{color:var(--ok)}.status.opencode-failed,.status.bridge-error,.status.diff-check-failed{color:var(--danger)}.terminal{background:#05080c;border:1px solid #22303e;border-radius:12px;padding:11px;font:12px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;min-height:460px;max-height:650px;overflow:auto;white-space:pre-wrap;color:#cfe4d5}.terminaltop{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:9px}.memory{background:var(--card);border-left:3px solid var(--violet);border-radius:9px;padding:9px;margin:7px 0}.activity{display:grid;gap:7px}.event{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:9px;display:grid;grid-template-columns:145px 120px 1fr;gap:8px}.event time,.event .kind{color:var(--muted);font-size:12px}.helpstep{margin:8px 0;color:#ccd7e2}.helpstep a{display:inline-block;margin-top:5px}.deep{background:#0d1720;border:1px solid #27435a;border-radius:9px;padding:8px 10px;display:inline-block}.settingsgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.settingrow{display:flex;justify-content:space-between;gap:16px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}.settingrow:last-child{border-bottom:0}.settingrow label:first-child{font-weight:600}.settingrow .small{max-width:440px}.switch{width:44px;height:24px;accent-color:var(--accent)}.notice{border-left:3px solid var(--accent);padding:9px 10px;background:var(--card);border-radius:9px;margin:7px 0}.notice[data-s="critical"]{border-left-color:var(--danger)}.notice[data-s="warning"]{border-left-color:var(--warn)}.notice[data-s="success"]{border-left-color:var(--ok)}.badge{display:inline-block;min-width:18px;padding:1px 5px;border-radius:999px;background:var(--danger);color:white;font-size:10px;text-align:center}.badge:empty{display:none}body.compact .project,body.compact .panel,body.compact .task,body.compact .agentcard,body.compact .modelcard,body.compact .teamcard{padding:9px}body.large-text{font-size:17px}body.reduced-motion *{scroll-behavior:auto!important;transition:none!important;animation:none!important}.modalwrap{display:none;position:fixed;inset:0;z-index:30;background:rgba(0,0,0,.72);align-items:center;justify-content:center;padding