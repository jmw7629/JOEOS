yle="margin-bottom:10px"><div><h2 style="margin:0">Model hub</h2><div class="small">Connect brains once, then route agents to the models best suited to their work. Secrets remain server-side.</div></div><button id="addModel" class="btn primary adminonly">+ Connect model</button></div><div id="modelGrid" class="modelgrid"></div></section>
<section id="team" class="view"><div class="between" style="margin-bottom:10px"><div><h2 style="margin:0">Team access</h2><div class="small">Independent, revocable PROJECT_BYTE credentials. Do not share the owner key.</div></div><button id="addPerson" class="btn primary adminonly">+ Collaborator</button></div><div id="teamGrid" class="teamgrid"></div></section>
<section id="activity" class="view"><div id="activityList" class="activity"></div></section>
<section id="settings" class="view"><div class="between" style="margin-bottom:10px"><div><h2 style="margin:0">Settings</h2><div class="small">Personal preferences are stored per PROJECT_BYTE user and follow you across devices.</div></div><button id="saveSettings" class="btn primary authonly">Save settings</button></div><div class="settingsgrid">
<div class="panel"><h2>Notifications</h2><div class="settingrow"><div><label>In-app notifications</label><div class="small">Alerts appear in the PROJECT_BYTE notification center.</div></div><input id="setNotifyInApp" class="switch" type="checkbox"></div><div class="settingrow"><div><label>Browser notifications</label><div class="small">Use the browser/OS notification system when permission is granted.</div></div><input id="setNotifyBrowser" class="switch" type="checkbox"></div><div class="settingrow"><div><label>AI completed</label><div class="small">Notify when an agent creates work ready for review.</div></div><input id="setNotifyAISuccess" class="switch" type="checkbox"></div><div class="settingrow"><div><label>AI failed / blocked</label><div class="small">Bridge, model, verification, or no-change failures.</div></div><input id="setNotifyAIFailure" class="switch" type="checkbox"></div><div class="settingrow"><div><label>Critical blockers</label><div class="small">Critical work enters or remains Blocked.</div></div><input id="setNotifyBlocked" class="switch" type="checkbox"></div><div class="settingrow"><div><label>Overdue work</label><div class="small">Open work has passed its due date.</div></div><input id="setNotifyOverdue" class="switch" type="checkbox"></div><div class="settingrow"><div><label>Due soon</label><div class="small">Open work is due within two days.</div></div><input id="setNotifyDue" class="switch" type="checkbox"></div><div class="settingrow"><div><label>Security / configuration</label><div class="small">Authentication lockouts and operational configuration alerts.</div></div><input id="setNotifySecurity" class="switch" type="checkbox"></div><div class="settingrow"><div><label>Quiet hours</label><div class="small">Suppress browser popups during your chosen window; in-app notices remain available.</div></div><input id="setQuiet" class="switch" type="checkbox"></div><div class="grid2"><label class="label">Quiet start<input id="setQuietStart" type="time"></label><label class="label">Quiet end<input id="setQuietEnd" type="time"></label></div><div class="flex" style="margin-top:10px"><button id="enableBrowserNotify" class="mini">Enable browser notifications</button><button id="markAllRead" class="mini">Mark all read</button></div></div>
<div class="panel"><h2>Notification center</h2><div class="between" style="margin-bottom:8px"><div class="small"><span id="unreadCount">0</span> unread</div><button id="refreshNotifications" class="mini">Refresh</button></div><div id="notificationList"></div></div>
<div class="panel"><h2>Dashboard & display</h2><div class="grid2"><label class="label">Default view<select id="setDefaultView"><option value="home">Home</option><option value="portfolio">Portfolio</option><option value="board">Kanban</option><option value="intelligence">Work next</option><option value="ai">AI</option><option value="agents">Agents</option><option value="terminalView">Terminal</option><option value="models">Models</option><option value="team">Team</option><option value="activity">Activity</option><option value="settings">Settings</option><option value="help">Help</option></select></label><label class="label">Default project<select id="setDefaultProject"><option value="">All projects</option></select></label><label class="label">Refresh interval<select id="setRefresh"><option value="5">5 seconds</option><option value="10">10 seconds</option><option value="15">15 seconds</option><option value="30">30 seconds</option><option value="60">1 minute</option><option value="120">2 minutes</option></select></label><label class="label">Density<select id="setDensity"><option value="comfortable">Comfortable</option><option value="compact">Compact</option></select></label><label class="label wide">Timezone<input id="setTimezone" placeholder="America/New_York"></label></div><div class="settingrow"><div><label>Show completed work</label><div class="small">Include Done tasks in normal Portfolio/Kanban views.</div></div><input id="setShowCompleted" class="switch" type="checkbox"></div><div class="settingrow"><div><label>Reduced motion</label><div class="small">Disable nonessential animation and smooth scrolling.</div></div><input id="setReducedMotion" class="switch" type="checkbox"></div><div class="settingrow"><div><label>Larger text</label><div class="small">Increase the base dashboard type size.</div></div><input id="setLargeText" class="switch" type="checkbox"></div></div>
<div class="panel"><h2>AI execution defaults</h2><div class="grid2"><label class="label">Default agent<select id="setDefaultAgent"></select></label><label class="label">Default model<select id="setDefaultModel"></select></label></div><div class="settingrow"><div><label>Confirm before Queue to AI</label><div class="small">Require an explicit confirmation before a task becomes executable work.</div></div><input id="setConfirmQueue" class="switch" type="checkbox"></div><div class="settingrow"><div><label>Open Terminal after queue</label><div class="small">Automatically switch to the run/terminal when a task is queued.</div></div><input id="setAutoTerminal" class="switch" type="checkbox"></div><div class="flex" style="margin-top:10px"><a href="#models" class="deep" data-go="models">Manage models</a><a href="#agents" class="deep" data-go="agents">Agent memory & learning</a></div></div>
<div class="panel"><h2>Filters & saved views</h2><div class="small">Each account keeps independent saved views. Use advanced filters to create combinations such as Mike + Critical + Blocked + Due ≤7 days.</div><div id="settingsSavedViews" style="margin-top:10px"></div><div class="flex" style="margin-top:10px"><button id="openFilters" class="mini">Open advanced filters</button><button id="clearSavedViews" class="mini danger">Delete all my saved views</button></div></div>
<div class="panel"><h2>Security & session</h2><div class="grid2"><label class="label">Session preference<select id="setSessionMinutes"><option value="60">1 hour</option><option value="240">4 hours</option><option value="480">8 hours</option><option value="720">12 hours</option><option value="1440">24 hours</option></select></label><label class="label">Current access<input id="currentAccess" readonly></label></div><div class="small" style="margin-top:8px">Five failed login attempts from one source trigger a temporary lock. Collaborator credentials are individually revocable. The owner key is never displayed here.</div><div class="flex" style="margin-top:10px"><button id="logoutAllLocal" class="mini danger">Sign out on this device</button><a href="#team" class="deep adminonly" data-go="team">Manage access</a></div></div>
<div class="panel"><h2>Integrations & operations</h2><div id="opsHealth" class="small">Checking PROJECT_BYTE services…</div><div class="flex" style="margin-top:10px"><button id="checkHealth" class="mini">Check health</button><a href="#models" class="deep" data-go="models">LLM connections</a><a href="#terminalView" class="deep" data-go="terminalView">Execution logs</a><a href="#help" class="deep" data-go="help">Troubleshoot</a></div></div>
<div class="panel"><h2>Data & portability</h2><div class="small">Export a local JSON snapshot of the project/task/activity data visible to your account. This does not include server secrets or raw bridge credentials.</div><div class="flex" style="margin-top:10px"><button id="exportSnapshot" class="mini">Download workspace snapshot</button></div></div>
</div></section>
<section id="help" class="view"><div class="panel" style="margin-bottom:12px"><h2>How to use PROJECT_BYTE</h2><div class="small">Use these task-oriented guides or ask the Help Agent in the AI tab. Links below navigate directly to the relevant workspace.</div></div><div class="helpgrid">
<article class="helpcard"><h3>Run a project like an executive</h3><div class="helpstep">Start in Portfolio. Set health, goal, stage, lead, repository, live URL and target date.</div><a href="#portfolio" class="deep" data-go="portfolio">Open Portfolio</a><div class="helpstep">Then open Work Next to see the highest-leverage work based on risk, urgency and dependencies.</div><a href="#intelligence" class="deep" data-go="intelligence">Open Work Next</a></article>
<article class="helpcard"><h3>Filter Joe, Mike, or any workstream</h3><div class="helpstep">Use Task owner for individual assignments and Project lead for project ownership. Open Filters to combine status, health, stage, executor, agent, model, due window, milestone, dependency, update age, repository and AI-run state.</div><a href="#board" class="deep" data-go="board" data-open-filters="1">Open filters</a></article>
<article class="helpcard"><h3>Queue work to an AI agent</h3><div class="helpstep">Open a Kanban task, set Executor=AI, select Agent and Model, then save it.</div><a href="#board" class="deep" data-go="board">Open Kanban</a><div class="helpstep">Use AI to refine the prompt, then press Queue selected task to AI. Queueing is deliberate; editing a card alone never launches code.</div><a href="#ai" class="deep" data-go="ai">Open AI</a></article>
<article class="helpcard"><h3>See what agents are doing</h3><div class="helpstep">Agents shows live/recent runs, status, requested model and performance. Select a run and jump into Terminal for the bridge log.</div><a href="#agents" class="deep" data-go="agents">Open Agents</a> <a href="#terminalView" class="deep" data-go="terminalView">Open Terminal</a></article>
<article class="helpcard"><h3>Connect or troubleshoot an LLM</h3><div class="helpstep">Models shows provider, endpoint, model name, connection health, latency and historical success/failure.</div><a href="#models" class="deep" data-go="models">Open Models</a><div class="helpstep">If OpenAI fails, confirm the server-side environment variable for that model is configured. Never paste API keys into the browser. For OpenCode per-run routing, use the exact provider/model reference as the model key.</div></article>
<article class="helpcard"><h3>Agent is stuck or failed</h3><div class="helpstep">1. Agents → select the run. 2. Terminal → inspect the last log lines. 3. Open Issue/PR. 4. If dependency-blocked, return to Kanban and finish the dependency first.</div><a href="#agents" class="deep" data-go="agents">Inspect Agents</a> <a href="#board" class="deep" data-go="board">Inspect Dependencies</a></article>
<article class="helpcard"><h3>Add Mike or another collaborator</h3><div class="helpstep">Team → Add collaborator. PROJECT_BYTE generates a one-time strong key and stores only its hash. Admin can revoke or change roles independently.</div><a href="#team" class="deep" data-go="team">Open Team</a></article>
<article class="helpcard"><h3>Teach an agent</h3><div class="helpstep">Agents → + Memory. Store a project decision, preferred approach, failure lesson or verified constraint. Completed runs also create execution-outcome memories automatically.</div><a href="#agents" class="deep" data-go="agents">Open Memory</a></article>
<article class="helpcard"><h3>Why Queue to AI is disabled</h3><div class="helpstep">The project must have a repository and a connected bridge. Current verified bridges are StickDeath Infinity and VITROS. PROJECT_BYTE will not pretend unsupported projects can execute.</div><a href="#portfolio" class="deep" data-go="portfolio">Check project configuration</a></article>
</div></section><div id="status" class="statusline" aria-live="polite"></div></main>

<div id="taskModal" class="modalwrap"><form id="taskForm" class="modal"><h2 id="taskModalTitle">Work item</h2><input id="taskId" type="hidden"><div class="grid2"><label class="label">Title<input id="taskTitle" maxlength="120" required></label><label class="label">Project<input id="taskProject" list="projectNames" maxlength="80" required><datalist id="projectNames"></datalist></label><label class="label">Status<select id="taskStatus"><option>Backlog</option><option>Active</option><option>Blocked</option><option>Review</option><option>Done</option></select></label><label class="label">Priority<select id="taskPriority"><option>Critical</option><option>High</option><option>Medium</option><option>Low</option></select></label><label class="label">Progress %<input id="taskProgress" type="number" min="0" max="100"></label><label class="label">Due date<input id="taskDue" type="date"></label><label class="label">Milestone<input id="taskMilestone"></label><label class="label">Owner / lead<input id="taskOwner"></label><label class="label">Dependency<select id="taskDependency"><option value="">None</option></select></label><label class="label">Reference URL<input id="taskUrl" type="url" placeholder="https://..."></label><label class="label">Executor<select id="taskExecutor"><option value="human">Human</option><option value="ai">AI</option></select></label><label class="label">Agent<select id="taskAgent"></select></label><label class="label">Model<select id="taskModel"></select></label><label class="label wide">Next action / notes<textarea id="taskNote" maxlength="800"></textarea></label><label class="label wide">AI execution prompt<textarea id="taskPrompt" maxlength="12000" placeholder="Optional. Leave blank and PROJECT_BYTE will generate a bounded prompt from the task context."></textarea></label></div><div id="fileSection" style="margin-top:10px"><b>Attachments</b><div id="fileList"></div><label class="label authonly" style="margin-top:7px">Attach file<input id="taskFile" type="file"></label><button type="button" id="uploadFile" class="btn authonly" style="margin-top:6px">Upload</button></div><div class="row"><button type="button" class="btn" data-close="taskModal">Cancel</button><button type="button" id="deleteTask" class="btn danger authonly">Delete</button><button type="button" id="queueTask" class="btn good authonly">Queue to AI</button><button class="btn primary authonly">Save</button></div></form></div>
<div id="projectModal" class="modalwrap"><form id="projectForm" class="modal"><h2 id="projectModalTitle">Project</h2><input id="projectName" type="hidden"><div class="grid2"><label class="labe