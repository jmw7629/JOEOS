nds_on:$('#taskDependency').value,url:$('#taskUrl').value,executor:$('#taskExecutor').value,agent_key:$('#taskAgent').value,model_key:$('#taskModel').value,note:$('#taskNote').value,ai_prompt:$('#taskPrompt').value};try{if(id)await api('/api/tasks/'+id,{method:'PATCH',body:JSON.stringify(d)});else await api('/api/tasks',{method:'POST',body:JSON.stringify(d)});closeModal('taskModal');await load()}catch(x){$('#status').textContent=x.message}};
$('#projectForm').onsubmit=async e=>{e.preventDefault();const n=$('#projectName').value,d={health:$('#projectHealth').value,stage:$('#projectStage').value,lead:$('#projectLead').value,target_date:$('#projectTarget').value,repo:$('#projectRepo').value,live_url:$('#projectLive').value,goal:$('#projectGoal').value,notes:$('#projectNotes').value};try{await api('/api/projects/'+encodeURIComponent(n),{method:'PATCH',body:JSON.stringify(d)});closeModal('projectModal');await load()}catch(x){$('#status').textContent=x.message}};
$('#modelForm').onsubmit=async e=>{e.preventDefault();try{await api('/api/models',{method:'POST',body:JSON.stringify({model_key:$('#modelKey').value,display_name:$('#modelName').value,provider:$('#modelProvider').value,model_name:$('#modelModel').value,endpoint:$('#modelEndpoint').value,secret_env:$('#modelSecret').value,capabilities:$('#modelCaps').value.split(',').map(x=>x.trim()).filter(Boolean),notes:$('#modelNotes').value,local:$('#modelProvider').value==='ollama'})});closeModal('modelModal');await load()}catch(x){$('#status').textContent=x.message}};
$('#personForm').onsubmit=async e=>{e.preventDefault();try{const x=await api('/api/team',{method:'POST',body:JSON.stringify({name:$('#personName').value,role:$('#personRole').value})});closeModal('personModal');alert(`ONE-TIME ACCESS KEY for ${x.name}:\n\n${x.access_key}\n\nSave it now. PROJECT_BYTE stores only its hash.`);await load()}catch(x){$('#status').textContent=x.message}};
$('#memoryForm').onsubmit=async e=>{e.preventDefault();try{await api('/api/memory',{method:'POST',body:JSON.stringify({agent_key:$('#memoryAgent').value,project:$('#memoryProject').value,kind:$('#memoryKind').value,confidence:Number($('#memoryConfidence').value),content:$('#memoryContent').value})});closeModal('memoryModal');await load()}catch(x){$('#status').textContent=x.message}};
$('#deleteTask').onclick=async()=>{const id=$('#taskId').value;if(!id||!confirm('Delete this work item?'))return;try{await api('/api/tasks/'+id,{method:'DELETE'});closeModal('taskModal');await load()}catch(e){$('#status').textContent=e.message}};
$('#queueTask').onclick=async()=>{const id=$('#taskId').value;if(!id)return;await api('/api/tasks/'+id,{method:'PATCH',body:JSON.stringify({executor:'ai',agent_key:$('#taskAgent').value,model_key:$('#taskModel').value,ai_prompt:$('#taskPrompt').value})});closeModal('taskModal');await load();const t=tasks.find(x=>x.id===id);$('#aiProject').value=t?.project||'';syncAITasks();$('#aiTask').value=id;$('#aiAgent').value=t?.agent_key||settings.ai?.default_agent||'builder';$('#aiModel').value=t?.model_key||settings.ai?.default_model||'';document.querySelector('[data-view="ai"]').click();syncAIContext()};
$('#uploadFile').onclick=async()=>{const id=$('#taskId').value,f=$('#taskFile').files[0];if(!id||!f)return;try{await api('/api/upload',{method:'POST',headers:{'X-Task-ID':id,'X-Filename':f.name,'Content-Type':f.type||'application/octet-stream'},body:f});await load();openTask(id)}catch(e){$('#status').textContent=e.message}};
$('#sendChat').onclick=()=>sendChat();$('#loadChat').onclick=loadChat;$('#draftPrompt').onclick=()=>sendChat('Draft a production-grade execution prompt for the selected task. Include mission, scope, constraints, acceptance gates, tests, security/persistence risks, and explicit non-goals. Do not execute it yet.');$('#askHelp').onclick=()=>{$('#aiAgent').value='help';sendChat('Help me use PROJECT_BYTE for the selected context. Give exact navigation and troubleshooting steps.');};$('#queueSelected').onclick=()=>queue($('#aiTask').value);$('#aiProject').onchange=()=>{syncAITasks();syncAIContext();loadChat()};$('#aiTask').onchange=()=>{syncAIContext();loadChat()};
$('#terminalRefresh').onclick=terminalLoad;$('#terminalRun').onchange=terminalLoad;$('#addModel').onclick=()=>openModal('modelModal');$('#addPerson').onclick=()=>openModal('personModal');$('#addMemory').onclick=()=>openModal('memoryModal');$('#newTask').onclick=()=>openTask('');$('#refresh').onclick=load;
$('#filterToggle').onclick=()=>$('#advancedFilters').classList.toggle('open');$('#clearFilters').onclick=clearFilters;$('#saveView').onclick=saveCurrentView;$('#deleteView').onclick=()=>deleteSavedView();$('#savedView').onchange=()=>applySavedView($('#savedView').value);$('#search').oninput=renderAll;for(const id of FILTER_IDS){const el=$('#'+id);if(el)el.onchange=()=>{if(id!=='savedView')$('#savedView').value='';renderAll()}}
$('#saveSettings').onclick=async()=>{try{await persistSettings(settingsFromForm());$('#status').textContent='Settings saved.';await loadNotifications()}catch(e){$('#status').textContent='Settings: '+e.message}};
$('#enableBrowserNotify').onclick=async()=>{if(!('Notification' in window)){alert('Browser notifications are not supported by this browser.');return}try{const p=await Notification.requestPermission();$('#status').textContent='Browser notification permission: '+p;if(p==='granted'){$('#setNotifyBrowser').checked=true;await persistSettings({notifications:{browser:true}})}}catch(e){$('#status').textContent=e.message}};
$('#refreshNotifications').onclick=loadNotifications;$('#markAllRead').onclick=async()=>{try{await api('/api/notifications/read',{method:'POST',body:JSON.stringify({all:true})});await loadNotifications()}catch(e){$('#status').textContent=e.message}};
$('#notifyBtn').onclick=()=>{document.querySelector('[data-view="settings"]').click();setTimeout(()=>$('#notificationList')?.scrollIntoView({behavior:settings.general?.reduced_motion?'auto':'smooth'}),50)};
$('#openFilters').onclick=()=>{$('#advancedFilters').classList.add('open');window.scrollTo({top:0,behavior:settings.general?.reduced_motion?'auto':'smooth'})};$('#clearSavedViews').onclick=async()=>{if(confirm('Delete all of your saved filter views?'))await persistSettings({filters:{saved_views:[],default_saved_view:''}})};
$('#logoutAllLocal').onclick=()=>{accessKey='';sessionStorage.removeItem('project_byte_access');sessionStorage.removeItem('pb_login_at');location.reload()};
async function checkHealth(){try{const h=await api('/healthz');const connected=models.filter(m=>m.last_status==='ok').length,active=runs.filter(r=>['queued','running'].includes(r.status)).length;$('#opsHealth').innerHTML=`PROJECT_BYTE v${esc(h.version)} · API healthy · ${connected}/${models.length} models tested OK · ${active} active AI runs · ${projects.filter(p=>p.repo).length} repositories configured` }catch(e){$('#opsHealth').textContent='Health check failed: '+e.message}}$('#checkHealth').onclick=checkHealth;
$('#exportSnapshot').onclick=()=>{const data={exported_at:new Date().toISOString(),user:{name:session.name,role:session.role},filter:filterCriteria(),projects:projects.filter(p=>projectMatches(p,visible())),tasks:visible(),activity,agents:session.level>=1?agents:[],runs:session.level>=1?runs.filter(r=>visible().some(t=>t.id===r.task_id)):[]};const b=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download='PROJECT_BYTE-snapshot-'+new Date().toISOString().slice(0,10)+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),5000)};
function enforceSessionTTL(){if(!session.ok)return false;let started=Number(sessionStorage.getItem('pb_login_at')||0),mins=Number(settings.security?.session_minutes||480);if(!started){started=Date.now();sessionStorage.setItem('pb_login_at',String(started));return false}if(Date.now()-started>mins*60000){accessKey='';sessionStorage.removeItem('project_byte_access');sessionStorage.removeItem('pb_login_at');alert('PROJECT_BYTE session expired. Sign in again.');location.reload();return true}return false}
function applyInitialLanding(){if(session.level>=1){const def=settings.filters?.default_saved_view;if(def)applySavedView(def);else if(settings.general?.default_project&&!$('#projectFilter').value){$('#projectFilter').value=settings.general.default_project;renderAll()}$('#aiAgent').value=settings.ai?.default_agent||'executive';$('#aiModel').value=settings.ai?.default_model||''}const hash=location.hash.replace('#',''),target=document.querySelector(`[data-view="${hash||settings.general?.default_view||'portfolio'}"]`);if(target)target.click();checkHealth()}
document.addEventListener('click',async e=>{const t=e.target;if(t.dataset.view){document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===t));document.querySelectorAll('.view').forEach(x=>x.classList.toggle('active',x.id===t.dataset.view));history.replaceState(null,'','#'+t.dataset.view);if(t.dataset.view==='settings')checkHealth()}if(t.dataset.close)closeModal(t.dataset.close);if(t.dataset.focus){$('#projectFilter').value=t.dataset.focus;document.querySelector('[data-view="board"]').click();renderAll()}if(t.dataset.editProject)openProject(t.dataset.editProject);if(t.dataset.openTask)openTask(t.dataset.openTask);if(t.dataset.aiProject){$('#aiProject').value=t.dataset.aiProject;syncAITasks();document.querySelector('[data-view="ai"]').click();syncAIContext();loadChat()}if(t.dataset.terminalRun){$('#terminalRun').value=t.dataset.terminalRun;document.querySelector('[data-view="terminalView"]').click();terminalLoad()}if(t.dataset.testModel){try{const x=await api('/api/models/test',{method:'POST',body:JSON.stringify({model_key:t.dataset.testModel})});$('#status').textContent=`Model test ${x.ok?'PASS':'FAIL'} · ${x.latency_ms||0} ms`;await load()}catch(x){$('#status').textContent='Model test: '+x.message}}if(t.dataset.togglePerson){try{await api('/api/team/'+t.dataset.togglePerson,{method:'PATCH',body:JSON.stringify({active:Number(t.dataset.active)===1,role:t.dataset.role||'editor'})});await load()}catch(x){$('#status').textContent=x.message}}if(t.dataset.go){document.querySelector(`[data-view="${t.dataset.go}"]`)?.click();if(t.dataset.openFilters)$('#advancedFilters').classList.add('open');e.preventDefault()}if(t.dataset.lead){$('#leadFilter').value=t.dataset.lead;$('#advancedFilters').classList.add('open');renderAll()}if(t.dataset.ownerView){$('#ownerFilter').value=t.dataset.ownerView;$('#advancedFilters').classList.add('open');document.querySelector('[data-view="board"]').click();renderAll()}if(t.dataset.leadView){$('#leadFilter').value=t.dataset.leadView;$('#advancedFilters').classList.add('open');document.querySelector('[data-view="portfolio"]').click();renderAll()}if(t.dataset.applyView)applySavedView(t.dataset.applyView);if(t.dataset.readNotice){try{await api('/api/notifications/read',{method:'POST',body:JSON.stringify({id:t.dataset.readNotice})});await loadNotifications()}catch(x){$('#status').textContent=x.message}}if(t.dataset.noticeLink){const v=t.dataset.noticeLink.replace('#','');document.querySelector(`[data-view="${v}"]`)?.click()}});
setSession();load().then(()=>{if(!enforceSessionTTL())applyInitialLanding()});setInterval(enforceSessionTTL,60000);
</script></body></html>
